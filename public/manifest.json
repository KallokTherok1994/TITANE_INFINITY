      "icons": []
    },
    {
      "name": "Statistiques",
      "short_name": "Stats",
      "description": "Voir les metriques systeme",
      "url": "/stats",
      "icons": []
    }
  ],
  "prefer_related_applications": false,
  "related_applications": [],
