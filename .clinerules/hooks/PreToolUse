#!/usr/bin/env bash
# PreToolUse hook for TITANE∞
# Empêche les opérations interdites et valide les paramètres

input=$(cat)

tool_name=$(echo "$input" | jq -r '.preToolUse.toolName')

# Bloquer les déploiements non autorisés
if [[ "$tool_name" == "execute_command" ]]; then
  command=$(echo "$input" | jq -r '.preToolUse.parameters.command // ""')
  
  # Détecter les tentatives de build production
  if echo "$command" | grep -qiE 'tauri build|Build Titan-Stable|build:production'; then
    error_msg="RULE 11 NOTICE: Build/déploiement production gouverné détecté.\n"
    error_msg+="Aucun token local n'est autorisé. Une demande utilisateur explicite suffit.\n"
    error_msg+="Si la demande n'est pas explicite dans le prompt courant: BLOCKED_APPROVAL."
    
    jq -n --arg msg "$error_msg" '{"cancel": true, "errorMessage": $msg}'
    exit 0
  fi
  
  # Détecter sudo/dpkg (installation système)
  if echo "$command" | grep -qiE 'sudo.*dpkg|dpkg.*-i.*\.deb|apt install'; then
    error_msg="⚠️ VIOLATION: Installation système non autorisée sans approbation explicite.\n"
    error_msg+="L'installation système nécessite l'autorisation de Kevin Thibault."
    
    jq -n --arg msg "$error_msg" '{"cancel": true, "errorMessage": $msg}'
    exit 0
  fi
fi

# Écriture de fichiers — vérification secrets uniquement
if [[ "$tool_name" == "write_to_file" ]]; then
  # Empêcher l'écriture de secrets dans src/** (avertissement non-bloquant)
  file_path=$(echo "$input" | jq -r '.preToolUse.parameters.path // ""')
  content=$(echo "$input" | jq -r '.preToolUse.parameters.content // ""')
  if [[ "$file_path" =~ ^src/ ]] && echo "$content" | grep -qiE 'API[_-]?KEY|SECRET|PASSWORD|TOKEN.*=.*[a-zA-Z0-9]{20,}'; then
    context="SECURITY WARNING: Secret potentiel détecté dans src/. Utiliser les variables d'environnement."
    jq -n --arg ctx "$context" '{"cancel": false, "contextModification": $ctx}'
    exit 0
  fi
fi

echo '{"cancel": false}'
