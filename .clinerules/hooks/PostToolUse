#!/usr/bin/env bash
# PostToolUse hook for TITANE∞ — v3 (sobered)
# op_status=SUCCESS/FAIL uniquement. Pas de verdict PASS gouverné depuis un succès outil.
# PASS gouverné requiert une preuve explicite (Rule 2 canon).

input=$(cat)

execution_time=$(echo "$input" | jq -r '.postToolUse.executionTimeMs // 0')
tool_name=$(echo "$input" | jq -r '.postToolUse.toolName')
success=$(echo "$input" | jq -r '.postToolUse.success')

context=""

# OPERATION STATUS — pas un verdict gouverné.
# success=true = l'outil s'est exécuté. Ce n'est PAS un PASS constitutionnel.
# PASS gouverné nécessite une preuve explicite (.clinerules/00-kernel.md Rule 2).
if [[ "$success" == "false" ]]; then
  context="op_status=FAIL tool=$tool_name — Rule 8 stop-the-line. Diagnostiquer avant de continuer."

  # Détection contextuelle d'échec
  if [[ "$tool_name" == "execute_command" ]]; then
    result=$(echo "$input" | jq -r '.postToolUse.result // ""')
    if echo "$result" | grep -qiE 'error.*TS[0-9]+|TypeScript error'; then
      context+="\nTS_ERROR: Compilation TypeScript échouée — vérifier les types."
    fi
    if echo "$result" | grep -qiE 'test.*failed|FAIL'; then
      context+="\nTEST_FAIL: Tests échoués — vérifier les assertions."
    fi
  fi
fi

# AutoHeal: entrées écrites manuellement par Rule 10 — non auto-capturées
# (auto-capture désactivée: générait du JSON multi-lignes dans JSONL — défaut de format)

# Log sobre des opérations critiques (sans inflation de statut)
if [[ "$tool_name" =~ ^(write_to_file|execute_command)$ ]]; then
  log_dir=".clinerules/logs"
  mkdir -p "$log_dir"
  timestamp=$(echo "$input" | jq -r '.timestamp // empty')
  [[ -z "$timestamp" ]] && timestamp=$(date -Iseconds)
  echo "$timestamp: $tool_name (${execution_time}ms) success=$success" >> "$log_dir/operations.log"
fi

# OLLAMA_DEV usage logging
if [[ "$tool_name" == "execute_command" ]]; then
  command=$(echo "$input" | jq -r '.postToolUse.parameters.command // ""' 2>/dev/null || echo "")
  if echo "$command" | grep -qiE 'ollama|11434|api/generate'; then
    ollama_log=".clinerules/logs/ollama-dev.log"
    mkdir -p "$(dirname "$ollama_log")"
    status="ok"
    [[ "$success" == "false" ]] && status="fail"
    echo "${timestamp} | ROUTER=cline | MODEL=qwen3.5:9b | ACTION=command | STATUS=${status} | CMD=${command:0:120}" >> "$ollama_log"
  fi
fi

# Anti-loop: si l'outil a réussi, confirmer explicitement que
# le résultat est terminal. Vide = repo propre = décision finale.
if [[ "$success" == "true" && "$tool_name" =~ ^(write_to_file|execute_command)$ ]]; then
  context+="\nVERIFY_STATE: Repo check complete. Empty output = clean. No re-check needed."
fi

if [[ -n "$context" ]]; then
  jq -n --arg ctx "$context" '{"cancel": false, "contextModification": $ctx}'
else
  echo '{"cancel": false}'
fi
