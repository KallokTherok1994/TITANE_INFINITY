# TITANE∞ — Template généré automatiquement (safe)
#
# Ce fichier est une version *exemple* sans secrets.
# Copiez-le vers le fichier sans suffixe (.env.*) et remplissez localement.
# Ne jamais commit les fichiers .env* (sauf *.example).

# ═══════════════════════════════════════════════════════════════
#   TITANE∞ - Configuration Ollama Locale — OLLAMA CHAMPION MODE
# ═══════════════════════════════════════════════════════════════

# URL du serveur Ollama local
OLLAMA_BASE_URL=__REDACTED__

# Modèle par défaut pour TITANE∞ — OLLAMA CHAMPION
# OLLAMA CHAMPION utilise llama3.2:latest (léger, rapide) pour les modes simples
# et llama3.1:latest (puissant) pour DEEP_REASONING, ARCHITECT, CERTIFY.
# Modèles disponibles: llama3.1, codellama, mistral, qwen2.5-coder, llama3.2
OLLAMA_DEFAULT_MODEL=__REDACTED__

# Configuration alternative pour l'ancien système (compatibility)
TITANE_OLLAMA_MODEL=__REDACTED__

# Timeout requête Ollama (secondes, borné 10..300, défaut 120)
# OLLAMA_REQUEST_TIMEOUT_SECS=120

# ═══════════════════════════════════════════════════════════════
#   OLLAMA CHAMPION — Paramètres de Référence
# ═══════════════════════════════════════════════════════════════
#
# Modèles Recommandés (par ordre de performance) :
#   • llama3.1:latest (4.58 GB) — Champion DEEP_REASONING/ARCHITECT/CERTIFY
#   • llama3.2:latest (1.88 GB) — Champion DIRECT/CLARIFY_LIGHT/REPAIR/EXPLORATION
#   • mistral:latest  (4.07 GB) — Alternative performante, rapide
#   • codellama:latest (3.56 GB) — Optimisé pour code (REPAIR/ARCHITECT)
#   • qwen2.5-coder:latest (4.36 GB) — Excellent code/CERTIFY
#
# Fenêtre contexte : numCtx=8192 (supporte réponses DEVELOPED + system prompt)
# Température      : 0.7 (équilibre créativité/précision)
# Comparaison      : enabled=true, sample_rate=5% (monitoring qualité)
#
# Pour activer OLLAMA CHAMPION : assurer llama3.2:latest et llama3.1:latest installés
#   ollama pull llama3.2:latest
#   ollama pull llama3.1:latest
#
# Pour lister les modèles installés :
#   ollama list
#
# Pour démarrer Ollama (si pas auto-start) :
#   ollama serve
#
# ═══════════════════════════════════════════════════════════════
#   NOTES D'UTILISATION
# ═══════════════════════════════════════════════════════════════
#
# Ollama Status: ✅ OPÉRATIONNEL (version 0.13.5)
#
# Modèles installés:
#   • llama3.1:latest (4.58 GB) - Recommandé pour usage général
#   • codellama:latest (3.56 GB) - Optimisé pour code
#   • mistral:latest (4.07 GB) - Rapide et performant
#   • qwen2.5-coder:latest (4.36 GB) - Excellent pour code
#   • llama3.2:latest (1.88 GB) - Léger et rapide
#
# Pour installer un nouveau modèle:
#   ollama pull <model-name>
#
# Pour lister les modèles:
#   ollama list
#
# Pour démarrer Ollama (si pas auto-start):
#   ollama serve
#
# ═══════════════════════════════════════════════════════════════
