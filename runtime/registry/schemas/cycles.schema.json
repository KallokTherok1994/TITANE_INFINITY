{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TITANE∞ Registry Cycles (v2)",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "activeCycleId", "open", "closed"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "generatedAt": { "type": ["string", "null"], "format": "date-time" },
    "activeCycleId": { "type": ["string", "null"] },
    "open": { "type": "array", "items": { "type": "object" } },
    "closed": { "type": "array", "items": { "type": "object" } }
  }
}
