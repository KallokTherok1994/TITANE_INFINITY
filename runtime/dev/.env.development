# ═══════════════════════════════════════════════════════════════════════════
# TITANE∞ — DEV RUNTIME ENVIRONMENT VARIABLES (Development)
# ═══════════════════════════════════════════════════════════════════════════

# Build Mode
NODE_ENV=development
VITE_MODE=development
TAURI_ENV=development

# TITANE∞ Configuration
VITE_TITANE_RUNTIME=dev
VITE_TITANE_VERSION=24.2.0-dev
VITE_TITANE_BUILD_TYPE=development

# Development Features
VITE_ENABLE_DEVTOOLS=true
VITE_ENABLE_HOT_RELOAD=manual
VITE_ENABLE_SOURCE_MAPS=true
VITE_ENABLE_PROFILER=true
VITE_ENABLE_DEBUG_LOGGING=true

# OMEGA Pipeline (Dev Mode)
VITE_OMEGA_ENABLED=true
VITE_OMEGA_MODE=development
VITE_OMEGA_LOGGING=verbose
VITE_OMEGA_TELEMETRY=true

# MemoryOS Configuration (Dev)
VITE_MEMORYOS_ENABLED=true
VITE_MEMORYOS_STORAGE=local
VITE_MEMORYOS_CACHE=volatile
VITE_MEMORYOS_COMPRESSION=false
VITE_MEMORYOS_DEBUG=true

# Cognitive Engines (Dev Testing)
VITE_COGNITIVE_ENGINE_ENABLED=true
VITE_REASONING_ENGINE_ENABLED=true
VITE_VISUAL_ENGINE_ENABLED=true
VITE_MEMORY_ENGINE_ENABLED=true
VITE_CHAT_IA_ENABLED=true

# Visual Engine (Dev Settings)
VITE_VISUAL_ENGINE_VERSION=21
VITE_VISUAL_ENGINE_FPS=60
VITE_VISUAL_ENGINE_QUALITY=high
VITE_VISUAL_ENGINE_PARTICLES=true
VITE_VISUAL_ENGINE_TRANSITIONS=smooth
VITE_VISUAL_ENGINE_DEBUG=true

# Security (Relaxed for Dev)
VITE_ENABLE_CSP=false
VITE_ENABLE_CORS=true
VITE_ALLOW_EXTERNAL_SCRIPTS=true

# Monitoring (Full in Dev)
VITE_ENABLE_MONITORING=true
VITE_ENABLE_ERROR_TRACKING=true
VITE_ENABLE_PERFORMANCE_TRACKING=true
VITE_ENABLE_NETWORK_TRACKING=true

# API Configuration (Dev)
VITE_API_BASE_URL=http://localhost:3000
VITE_API_TIMEOUT=30000
VITE_API_RETRY=3

# Build Optimizations (Disabled for faster dev builds)
VITE_BUILD_SOURCEMAP=true
VITE_BUILD_MINIFY=false
VITE_BUILD_TREESHAKE=false
VITE_BUILD_COMPRESSION=false

# Logging (Verbose)
VITE_LOG_LEVEL=debug
VITE_LOG_CONSOLE=true
VITE_LOG_FILE=true
VITE_LOG_FILE_PATH=runtime/dev/logs/

# Dev Tools
VITE_REACT_DEVTOOLS=true
VITE_REDUX_DEVTOOLS=true
VITE_PROFILER_ENABLED=true

# Hot Module Replacement (HMR)
VITE_HMR_ENABLED=true
VITE_HMR_PORT=5173
VITE_HMR_HOST=localhost

# Telemetry for Claude Code Integration
VITE_CLAUDE_CODE_INTEGRATION=true
VITE_TELEMETRY_ENDPOINT=http://localhost:3001/telemetry

# Experimental Features (Safe to test in Dev)
VITE_EXPERIMENTAL_FEATURES=true
VITE_FEATURE_FLAG_VISUAL_V22=false
VITE_FEATURE_FLAG_MEMORY_V2=false

# ═══════════════════════════════════════════════════════════════════════════
# NOTE: This is the DEVELOPMENT environment for TITAN-DEV
# Safe experimentation zone - break things freely, test aggressively
# ═══════════════════════════════════════════════════════════════════════════
