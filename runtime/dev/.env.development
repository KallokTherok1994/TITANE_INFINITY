# TITANE∞ Development Environment Variables
# Default configuration for development runtime

# Base URL for Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Default model for Ollama (optional)
OLLAMA_DEFAULT_MODEL=

# Enable pulling models automatically (1 = true, 0 = false)
TITANE_OLLAMA_PULL_MODEL=0

# Development server port
DEV_SERVER_PORT=5173

# Enable full debug logging
DEBUG=true

# Additional environment variables can be added here