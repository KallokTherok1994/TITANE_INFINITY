# TITANE∞ Environment Variables Example
# Version: 27.0.0
# Description: Variables d'environnement pour configuration TITANE

# ══════════════════════════════════════════════════════════════════════════
# APPLICATION
# ══════════════════════════════════════════════════════════════════════════

# Mode environnement (development, production, test)
NODE_ENV=production

# Niveau de logs (debug, info, warn, error)
TITANE_LOG_LEVEL=info
RUST_LOG=info

# Port application (défaut: 3000 pour dev, pas utilisé en desktop mode)
# PORT=3000


# ══════════════════════════════════════════════════════════════════════════
# PROVIDERS IA
# ══════════════════════════════════════════════════════════════════════════

# Ollama (Local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2:latest
OLLAMA_TIMEOUT=30000

# Google Gemini (Cloud)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-pro

# Anthropic Claude (Cloud)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-opus-20240229

# OpenAI (Cloud)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4-turbo-preview


# ══════════════════════════════════════════════════════════════════════════
# MÉMOIRE & STOCKAGE
# ══════════════════════════════════════════════════════════════════════════

# Répertoire de stockage mémoire
TITANE_MEMORY_DIR=./runtime/memory

# Taille maximale mémoire (MB)
TITANE_MEMORY_MAX_SIZE=500

# Activer encryption mémoire long terme
TITANE_LTM_ENCRYPTION=true

# Intervalle backup automatique (heures)
TITANE_BACKUP_INTERVAL=24

# Nombre maximum de backups à conserver
TITANE_MAX_BACKUPS=7


# ══════════════════════════════════════════════════════════════════════════
# SÉCURITÉ
# ══════════════════════════════════════════════════════════════════════════

# Clé de chiffrement (générée automatiquement si vide)
# TITANE_ENCRYPTION_KEY=

# Activer mode strict HTTPS (si mode serveur)
# TITANE_FORCE_HTTPS=true

# CORS origins autorisés (si mode serveur, comma-separated)
# TITANE_CORS_ORIGINS=http://localhost:3000,https://titane.local


# ══════════════════════════════════════════════════════════════════════════
# PERFORMANCE
# ══════════════════════════════════════════════════════════════════════════

# Activer cache responses
TITANE_CACHE_ENABLED=true

# Durée cache (secondes)
TITANE_CACHE_TTL=3600

# Activer compression responses
TITANE_COMPRESSION=true

# Threads Rust (0 = auto-detect)
TITANE_WORKER_THREADS=0


# ══════════════════════════════════════════════════════════════════════════
# MONITORING & TELEMETRY
# ══════════════════════════════════════════════════════════════════════════

# Activer métriques Prometheus
# TITANE_METRICS_ENABLED=false

# Port métriques Prometheus
# TITANE_METRICS_PORT=9091

# Activer telemetry (anonyme, opt-in)
# TITANE_TELEMETRY_ENABLED=false


# ══════════════════════════════════════════════════════════════════════════
# DÉVELOPPEMENT
# ══════════════════════════════════════════════════════════════════════════

# Activer mode debug détaillé
# TITANE_DEBUG=false

# Activer hot-reload (dev only)
# TITANE_HOT_RELOAD=true

# Activer DevTools Tauri
# TAURI_DEBUG=false


# ══════════════════════════════════════════════════════════════════════════
# FEATURES EXPERIMENTALES
# ══════════════════════════════════════════════════════════════════════════

# Activer mode vision (webcam)
TITANE_VISION_ENABLED=true

# Activer Text-to-Speech
TITANE_TTS_ENABLED=false

# Activer Speech-to-Text
TITANE_STT_ENABLED=false


# ══════════════════════════════════════════════════════════════════════════
# NOTES D'UTILISATION
# ══════════════════════════════════════════════════════════════════════════
#
# 1. Copier ce fichier vers `.env` dans le répertoire racine:
#    cp docs/examples/.env.example .env
#
# 2. Éditer `.env` avec vos valeurs spécifiques
#
# 3. IMPORTANT: `.env` est dans .gitignore et ne sera PAS commité
#
# 4. Variables sensibles (API keys): JAMAIS les commiter dans Git
#
# 5. Pour production: Utiliser secrets management (Docker secrets, K8s secrets)
#
# 6. Variables avec valeurs par défaut: Pas besoin de définir si valeur OK
#
