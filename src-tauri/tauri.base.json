{
  "$schema": "https://schema.tauri.app/config/2.0",
  "$comment": "TITANE∞ Canonical Production Config — this file is the authoritative production configuration. Root tauri.base.json holds shared base settings that are merged into this file at build time.",
  "productName": "TITANE-Infinity",
  "version": "31.0.1",
  "identifier": "com.titane.infinity",
  "build": {
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "corepack pnpm exec vite dev --host 127.0.0.1 --port 1420 --strictPort",
    "beforeBuildCommand": "corepack pnpm exec vite build",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "copyright": "Copyright © 2025-2026 TITANE∞",
    "category": "Productivity",
    "shortDescription": "TITANE∞ - Cognitive Operating System",
    "longDescription": "TITANE Infinity - Cognitive Operating System, stable production release"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TITANE Infinity - Multi-Provider AI",
        "width": 1400,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true,
        "visible": true,
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' https://api.openai.com https://generativelanguage.googleapis.com",
      "allow": [
        {
          "command": "singularity_init"
        },
        {
          "command": "singularity_get_state"
        },
        {
          "command": "singularity_tick"
        },
        {
          "command": "singularity_sync"
        },
        {
          "command": "singularity_stop"
        },
        {
          "command": "singularity_health"
        },
        {
          "command": "singularity_metrics"
        },
        {
          "command": "singularity_module_info"
        },
        {
          "command": "run_auto_evolution"
        },
        {
          "command": "get_evolution_state"
        },
        {
          "command": "evolution_health_check"
        },
        {
          "command": "singularity_cortex_get_state"
        },
        {
          "command": "singularity_cortex_get_stats"
        },
        {
          "command": "singularity_cortex_get_context"
        },
        {
          "command": "singularity_cortex_set_mode"
        },
        {
          "command": "singularity_cortex_record_interaction"
        },
        {
          "command": "singularity_cortex_push_context"
        },
        {
          "command": "singularity_cortex_reset"
        },
        {
          "command": "backend_self_check"
        },
        {
          "command": "get_backend_info"
        },
        {
          "command": "validate_tauri_only"
        },
        {
          "command": "ai_query"
        },
        {
          "command": "speak"
        },
        {
          "command": "start_recording"
        },
        {
          "command": "stop_recording"
        },
        {
          "command": "transcribe_audio"
        },
        {
          "command": "get_conversation_history"
        },
        {
          "command": "new_conversation"
        },
        {
          "command": "delete_conversation"
        },
        {
          "command": "memory_get_conversations"
        },
        {
          "command": "memory_get_conversation"
        },
        {
          "command": "memory_delete_conversation"
        },
        {
          "command": "memory_export_conversation"
        },
        {
          "command": "memory_clear_all"
        },
        {
          "command": "system_get_vitals"
        },
        {
          "command": "system_get_processes"
        },
        {
          "command": "system_get_health"
        },
        {
          "command": "harmonia_get_state"
        },
        {
          "command": "harmonia_analyze_context"
        },
        {
          "command": "harmonia_balance"
        },
        {
          "command": "compactor_compact_file"
        },
        {
          "command": "compactor_compact_directory"
        },
        {
          "command": "compactor_get_stats"
        },
        {
          "command": "execute_secure_command"
        },
        {
          "command": "get_command_permissions"
        },
        {
          "command": "verify_command_signature"
        },
        {
          "command": "time_create_snapshot"
        },
        {
          "command": "time_restore_snapshot"
        },
        {
          "command": "time_list_snapshots"
        },
        {
          "command": "time_delete_snapshot"
        },
        {
          "command": "control_panel_get_status"
        },
        {
          "command": "control_panel_execute_action"
        }
      ]
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "http": {
      "scope": [
        "https://api.openai.com/*",
        "https://generativelanguage.googleapis.com/*"
      ]
    },
    "fs": {
      "scope": [
        "$APPDATA/*",
        "$APPCONFIG/*",
        "$APPLOCALDATA/*"
      ]
    }
  }
}
