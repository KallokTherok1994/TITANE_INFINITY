{
  "$schema": "https://schema.tauri.app/config/2.0/capability.json",
  "identifier": "secrets",
  "description": "Capability pour la gestion sécurisée des secrets TITANE∞",
  "windows": ["main"],
  "permissions": ["core:default"],
  "commands": {
    "allow": [
      "secure_store_secret",
      "secure_import_file",
      "secure_read_file",
      "secure_list_files",
      "secure_delete_file",
      "get_permission_audit"
    ],
    "deny": []
  },
  "remote": {
    "urls": []
  }
}
