{
  "$schema": "https://schema.tauri.app/config/2.0",
  "$comment": "TITANE∞ Stable Whitelist - PRODUCTION ONLY (no debug/qa/devtools)",

  "productName": "TITANE-Infinity",
  "version": "26.3.0",
  "identifier": "com.titane.infinity",
  "build": {
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bash scripts/tauri/before-dev.sh",
    "beforeBuildCommand": "cd /home/titane-os/Documents/GitHub/TITANE_INFINITY && /home/titane-os/.local/share/pnpm/pnpm exec vite build",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "copyright": "Copyright © 2025 TITANE",
    "category": "DeveloperTool",
    "shortDescription": "v26.3.0 Complete Audit (98/100), Documentation 200%, Titan-Stable build validated (AppImage + DEB); user rollout pending final validation",
    "longDescription": "TITANE Infinity v26.3.0 - Cognitive Operating System: Complete Audit (98/100), Documentation 200%, Performance Optimized, Titan-Stable build validated (AppImage + DEB); user rollout pending final validation"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TITANE Infinity v26.3.0 - Multi-Provider AI",
        "width": 1400,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true,
        "visible": true,
        "devtools": false
      },
      {
        "label": "avatar-floating",
        "title": "TITANE Avatar",
        "width": 400,
        "height": 600,
        "minWidth": 200,
        "minHeight": 300,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "center": false,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": false,
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset:; script-src 'self' asset: tauri:; style-src 'self' 'unsafe-inline' asset: tauri:; img-src 'self' asset: data: blob: https:; font-src 'self' asset: data:; connect-src 'self' tauri: asset: ipc: http: https: ws: wss:; media-src 'self' asset: blob: mediastream:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none';",
      "dangerousDisableAssetCspModification": true,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$RESOURCE/**", "$APPCONFIG/**", "$APPLOCALDATA/**"]
      },
      "capabilities": [
        {
          "identifier": "stable-capability",
          "description": "Capability for stable production runtime - STRICT",
          "windows": ["main"],
          "permissions": [
            "core:default",
            "core:event:default",
            "core:event:allow-listen",
            "core:event:allow-emit",
            "core:event:allow-emit-to",
            "core:window:default",
            "core:window:allow-show",
            "core:window:allow-hide",
            "core:window:allow-close",
            "core:window:allow-set-always-on-top",
            "core:window:allow-set-decorations",
            "core:window:allow-set-position",
            "core:window:allow-set-size",
            "core:window:allow-maximize",
            "core:window:allow-minimize",
            "core:window:allow-unmaximize",
            "core:window:allow-unminimize",
            "core:window:allow-center",
            "core:window:allow-set-title",
            "core:webview:default",
            "core:webview:allow-print",
            "core:app:default",
            "core:app:allow-app-show",
            "core:app:allow-app-hide",
            "clipboard-manager:default",
            "clipboard-manager:allow-read-text",
            "clipboard-manager:allow-write-text",
            "clipboard-manager:allow-read-image",
            "clipboard-manager:allow-write-image",
            "clipboard-manager:allow-clear",
            "dialog:default",
            "dialog:allow-open",
            "dialog:allow-save",
            "dialog:allow-message",
            "dialog:allow-ask",
            "dialog:allow-confirm"
          ],
          "allow": [
            { "command": "get_runtime_config" },
            { "command": "is_onboarding_complete" },
            { "command": "complete_onboarding" },
            { "command": "get_onboarding_preferences" },
            { "command": "get_helios_state" },
            { "command": "get_system_health" },
            { "command": "get_memory_state" },
            { "command": "memory_get_state" },
            { "command": "write_snapshot" },
            { "command": "read_snapshot" },
            { "command": "add_timeline_event" },
            { "command": "get_timeline" },
            { "command": "get_active_projects" },
            { "command": "get_recent_decisions" },
            { "command": "get_knowledge" },
            { "command": "get_active_rituals" },
            { "command": "save_chat_interaction" },
            { "command": "memory_ingest_file" },
            { "command": "orchestration_get_cognitive_state" },
            { "command": "orchestration_get_unified_state" },
            { "command": "singularity_get_full_state" },
            { "command": "singularity_get_physical" },
            { "command": "singularity_get_cognitive" },
            { "command": "singularity_get_global_coherence" },
            { "command": "singularity_is_critical" },
            { "command": "get_singularity_state" },
            { "command": "sync_singularity" },
            { "command": "singularity_get_symbolic" },
            { "command": "singularity_get_adaptive" },
            { "command": "singularity_get_meta" },
            { "command": "singularity_get" },
            { "command": "singularity_set" },
            { "command": "singularity_sync" },
            { "command": "singularity_export_json" },
            { "command": "experience_get_state" },
            { "command": "experience_update_state" },
            { "command": "import_file" },
            { "command": "file_analyze" },
            { "command": "upload_and_process_file" },
            { "command": "get_system_info" },
            { "command": "cp_get_ai_config" },
            { "command": "cp_set_ai_config" },
            { "command": "chat_generate" },
            { "command": "chat_stream_message" },
            { "command": "chat_generate_glm46v" },
            { "command": "check_glm46v_health" },
            { "command": "start_glm46v_server" },
            { "command": "stop_glm46v_server" },
            { "command": "fullbody_init" },
            { "command": "fullbody_update_pose" },
            { "command": "fullbody_update_expression" },
            { "command": "fullbody_get_state" },
            { "command": "avatar_get_expression" },
            { "command": "tts_speak_parler" },
            { "command": "tts_stop" },
            { "command": "tts_is_speaking" },
            { "command": "tts_get_status" }
          ],
          "deny": [
            { "command": "core:webview:allow-internal-toggle-devtools" },
            { "command": "qa_*" },
            { "command": "one_core_*" },
            { "command": "get_logs" },
            { "command": "clear_logs" },
            { "command": "validate_nexus" },
            { "command": "get_nexus_graph" },
            { "command": "write_log" },
            { "command": "read_logs" },
            { "command": "singularity_selftest_full" },
            { "command": "singularity_diff" },
            { "command": "singularity_hash" },
            { "command": "singularity_meta" },
            { "command": "singularity_integrity" },
            { "command": "singularity_repair" },
            { "command": "singularity_snapshot" },
            { "command": "get_helios_metrics" }
          ]
        },
        {
          "identifier": "avatar-floating-capability",
          "description": "Capability for the floating avatar window",
          "windows": ["avatar-floating"],
          "permissions": [
            "core:default",
            "core:event:default",
            "core:window:default",
            "core:window:allow-set-always-on-top",
            "core:window:allow-set-ignore-cursor-events",
            "core:window:allow-set-position",
            "core:window:allow-set-size",
            "core:window:allow-show",
            "core:window:allow-hide",
            "core:window:allow-set-focus",
            "core:window:allow-current-monitor",
            "core:window:allow-available-monitors"
          ]
        }
      ]
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "title": "TITANE∞"
    }
  },
  "plugins": {
    "http": {
      "all": false,
      "scope": [
        "http://127.0.0.1:*",
        "http://localhost:*"
      ]
    },
    "shell": {
      "open": false,
      "scope": []
    },
    "updater": {
      "endpoints": [
        "https://raw.githubusercontent.com/KallokTherok1994/TITANE_INFINITY/MAIN/latest.json"
      ]
    }
  }
}
