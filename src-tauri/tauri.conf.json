{
  "$schema": "https://schema.tauri.app/config/2.0",
  "productName": "TITANE∞ v17.3",
  "version": "17.3.0",
  "identifier": "com.titane.infinity",
  "build": {
    "beforeDevCommand": "pnpm run build",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "copyright": "Copyright © 2025 TITANE",
    "category": "DeveloperTool",
    "shortDescription": "Phase 8 Complete - Production Hardening + Multi-Platform Deployment",
    "longDescription": "TITANE∞ v17.3.0 - Phase 8 Production Hardening: ErrorBoundary, Performance Monitoring, Accessibility WCAG 2.1 AA, Security Hardening, Bundle Optimization, Multi-Platform CI/CD (Linux/Windows/macOS), 100% Tauri v2, Production-Ready"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TITANE∞ v17.3",
        "width": 1400,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": false,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$RESOURCE/**"]
      }
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false,
      "title": "TITANE∞"
    }
  },
  "plugins": {
    "shell": {
      "open": false,
      "scope": []
    }
  }
}
