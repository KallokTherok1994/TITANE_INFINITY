*.db
*.sqlite
*.sqlite3

# Fichiers temporaires
*.tmp
*.temp
*.swp
*.swo
*~

# Build artifacts
target/
dist/
build/

# IDE
.vscode/
.idea/
*.iml

# OS
.DS_Store
Thumbs.db
