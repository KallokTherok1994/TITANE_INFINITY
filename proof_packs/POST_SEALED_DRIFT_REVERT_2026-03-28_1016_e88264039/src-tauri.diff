+    fn calculate_utility_score(importance: f32, content_len: usize, hint_count: usize) -> f32 {
+        let density = (content_len as f32 / 400.0).min(1.0);
+        (importance * 0.6 + density * 0.2 + (hint_count as f32 / 10.0).min(1.0) * 0.2)
