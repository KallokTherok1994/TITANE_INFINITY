+                Some(true),
+                None,
+            );
+        }
+
+        for task_id in blocked_tasks {
+            self.publish_event(
+                CoordinationEventKind::TaskBlocked,
+                "nexus",
+                Some(task_id),
+                "Task blocked by unsatisfied dependency or unavailable module".to_string(),
+                Some(false),
+                None,
+            );
+        }
+    }
+
+    fn evaluate_task_statuses(&mut self) {
+        let keys: Vec<String> = self.task_graph.keys().cloned().collect();
+        for task_id in keys {
+            let Some(task_snapshot) = self.task_graph.get(&task_id).cloned() else {
+                continue;
+            };
+
+            let module_ready = self
+                .module_registry
+                .get(&task_snapshot.module)
+                .map(|module| module.health != EngineHealth::Offline)
+                .unwrap_or(false);
+
+            let dependencies_satisfied = task_snapshot.dependencies.iter().all(|dependency| {
+                self.task_graph
+                    .get(dependency)
+                    .map(|task| matches!(task.status, TaskStatus::Completed | TaskStatus::Ready))
+                    .unwrap_or(false)
+            });
+
+            let mut next_status = if !module_ready {
+                TaskStatus::Blocked
+            } else if task_snapshot.dependencies.is_empty() {
+                task_snapshot.status
+            } else if dependencies_satisfied {
+                TaskStatus::Ready
+            } else {
+                TaskStatus::Blocked
+            };
+
+            if task_snapshot.task_id == "plan_actions" && dependencies_satisfied && module_ready {
+                next_status = TaskStatus::Completed;
+            }
+
+            if task_snapshot.task_id == "rebalance_execution"
+                && dependencies_satisfied
+                && module_ready
+            {
+                next_status = TaskStatus::Ready;
+            }
+
+            if let Some(task) = self.task_graph.get_mut(&task_id) {
+                task.status = next_status;
+
+                if matches!(task.status, TaskStatus::Ready | TaskStatus::Completed) {
+                    task.observations.push(TaskObservation {
+                        timestamp: task.last_update_ms,
+                        outcome: "dependency_check".to_string(),
+                        success: true,
+                        latency_ms: 1,
+                        detail: format!("{} dependencies satisfied", task.dependencies.len()),
+                    });
+                }
+            }
+        }
+    }
+
+    fn build_execution_plan(&self) -> CoordinationPlan {
+        let mut execution_order: Vec<TaskNode> = self.task_graph.values().cloned().collect();
+        execution_order.sort_by(|a, b| b.priority.cmp(&a.priority).then(a.task_id.cmp(&b.task_id)));
+
+        let blocked_tasks: Vec<String> = execution_order
+            .iter()
+            .filter(|task| task.status == TaskStatus::Blocked)
+            .map(|task| task.task_id.clone())
+            .collect();
+
+        let unsatisfied_dependencies: Vec<String> = execution_order
+            .iter()
+            .flat_map(|task| {
+                task.dependencies.iter().filter_map(|dependency| {
+                    self.task_graph.get(dependency).and_then(|dep_task| {
+                        if matches!(dep_task.status, TaskStatus::Completed | TaskStatus::Ready) {
+                            None
+                        } else {
+                            Some(format!("{} -> {}", task.task_id, dependency))
+                        }
+                    })
+                })
+            })
+            .collect();
+
+        let mut module_loads = HashMap::new();
+        for task in &execution_order {
+            let cost = task.estimated_cost as f32;
+            let module_load = self
+                .module_registry
+                .get(&task.module)
+                .map(|module| module.load)
+                .unwrap_or(0.0);
+            module_loads
+                .entry(task.module.clone())
+                .and_modify(|value| *value += cost + module_load)
+                .or_insert(cost + module_load);
+        }
+
+        let root_parallel_group: Vec<String> = execution_order
+            .iter()
+            .filter(|task| task.dependencies.is_empty() && task.status != TaskStatus::Blocked)
+            .map(|task| task.task_id.clone())
+            .collect();
+        let dependent_parallel_group: Vec<String> = execution_order
+            .iter()
+            .filter(|task| !task.dependencies.is_empty() && task.status != TaskStatus::Blocked)
+            .map(|task| task.task_id.clone())
+            .collect();
+
+        let parallel_groups = vec![root_parallel_group, dependent_parallel_group]
+            .into_iter()
+            .filter(|group| !group.is_empty())
+            .collect::<Vec<_>>();
+
+        let pattern = if !unsatisfied_dependencies.is_empty() || execution_order.len() >= 4 {
+            OrchestrationPattern::Supervisor
+        } else if parallel_groups.len() > 1 {
+            OrchestrationPattern::PeerToPeer
+        } else {
+            OrchestrationPattern::Hierarchical
+        };
+
+        CoordinationPlan {
+            pattern,
+            execution_order: execution_order
+                .into_iter()
+                .map(|task| task.task_id)
+                .collect(),
+            parallel_groups,
+            blocked_tasks,
+            unsatisfied_dependencies,
+            module_loads,
+            last_planned_ms: self.last_coordination_ms,
+        }
+    }
+
+    fn publish_event(
+        &mut self,
+        kind: CoordinationEventKind,
+        source: &str,
+        task_id: Option<String>,
+        detail: String,
+        success: Option<bool>,
+        latency_ms: Option<u64>,
+    ) {
+        self.event_sequence += 1;
+        self.event_log.push(CoordinationEvent {
+            event_id: format!("coord-{}", self.event_sequence),
+            kind,
+            source: source.to_string(),
+            task_id,
+            timestamp: self.last_coordination_ms,
+            success,
+            latency_ms,
+            detail,
+        });
+
+        if self.event_log.len() > 128 {
+            self.event_log.remove(0);
+        }
+    }
 }
 
