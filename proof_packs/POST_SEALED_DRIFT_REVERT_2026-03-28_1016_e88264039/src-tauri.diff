+
+    fn maybe_push_ranked_result(
+        &self,
+        candidates: &mut HashMap<MemoryId, MemoryQueryResult>,
+        item: MemoryItem,
+        request: &MemoryQuery,
+        query_embedding: &[f32],
+        now: u64,
+    ) {
+        if item.access_scope != request.owner_scope && item.access_scope != "system" {
+            return;
+        }
+        if item.importance < request.min_importance {
+            return;
+        }
+        if let Some(task_id) = &request.task_id {
+            if let Some(item_task_id) = &item.task_id {
+                if item_task_id != task_id && item.access_scope != "system" {
+                    return;
+                }
+            }
+        }
+        let semantic_score =
+            Self::semantic_similarity(query_embedding, &Self::generate_embedding(&item.content));
+        self.insert_query_result(candidates, item, semantic_score, now);
+    }
+
+    fn insert_query_result(
+        &self,
+        candidates: &mut HashMap<MemoryId, MemoryQueryResult>,
+        item: MemoryItem,
+        semantic_score: f32,
+        now: u64,
+    ) {
+        let recency_score = Self::recency_score(item.last_accessed, now);
+        let importance_score = item.importance.clamp(0.0, 1.0);
+        let relevance_score =
+            (recency_score * 0.25 + importance_score * 0.35 + semantic_score * 0.40)
+                .clamp(0.0, 1.0);
+
+        candidates
+            .entry(item.id.clone())
+            .and_modify(|existing| {
+                if relevance_score > existing.relevance_score {
+                    *existing = MemoryQueryResult {
+                        item: item.clone(),
+                        relevance_score,
+                        recency_score,
+                        importance_score,
+                        semantic_score,
+                    };
+                }
+            })
+            .or_insert(MemoryQueryResult {
+                item,
+                relevance_score,
+                recency_score,
+                importance_score,
+                semantic_score,
+            });
+    }
+
+    fn recency_score(last_accessed: u64, now: u64) -> f32 {
+        let age = now.saturating_sub(last_accessed) as f32;
+        (1.0 / (1.0 + age / 3_600_000.0)).clamp(0.0, 1.0)
+    }
+
+    fn generate_embedding(text: &str) -> Vec<f32> {
+        let mut vector = vec![0.0_f32; 64];
+        for (idx, byte) in text.bytes().enumerate() {
+            let position = idx % 64;
+            vector[position] += (byte as f32) / 255.0;
+        }
+        let norm = vector.iter().map(|v| v * v).sum::<f32>().sqrt();
+        if norm > 0.0 {
+            for value in &mut vector {
+                *value /= norm;
+            }
+        }
+        vector
+    }
+
+    fn semantic_similarity(a: &[f32], b: &[f32]) -> f32 {
+        if a.is_empty() || b.is_empty() {
+            return 0.0;
+        }
+        a.iter()
+            .zip(b.iter())
+            .map(|(left, right)| left * right)
+            .sum::<f32>()
+            .clamp(0.0, 1.0)
+    }
+
+    fn load_ltm_item(&self, id: &str) -> Option<MemoryItem> {
+        let metadata = self.ltm.index.get(id)?;
+        let bytes = std::fs::read(&metadata.file_path).ok()?;
+        serde_json::from_slice::<MemoryItem>(&bytes).ok()
+    }
+
+    fn prune_deque_tier(
+        tier: &mut VecDeque<MemoryItem>,
+        owner_scope: &str,
+        now: u64,
+        age_limit: u64,
+        importance_threshold: f32,
+    ) -> usize {
+        let before = tier.len();
+        tier.retain(|item| {
+            let age_ms = now.saturating_sub(item.created_at);
+            !(item.access_scope == owner_scope
+                && age_ms > age_limit
+                && item.importance < importance_threshold)
+        });
+        before.saturating_sub(tier.len())
+    }
+
+    fn collect_summary_candidates(
+        &self,
+        owner_scope: &str,
+        task_id: Option<String>,
+        tier: Option<MemoryTier>,
+    ) -> Vec<MemoryItem> {
+        let task_matches = |item: &MemoryItem| {
+            if item.access_scope != owner_scope && item.access_scope != "system" {
+                return false;
+            }
+            match &task_id {
+                Some(task) => item.task_id.as_deref() == Some(task.as_str()),
+                None => true,
+            }
+        };
+
+        let mut items = Vec::new();
+        match tier {
+            Some(MemoryTier::ShortTerm) => items.extend(
+                self.stm
+                    .items
+                    .iter()
+                    .filter(|item| task_matches(item))
+                    .cloned(),
+            ),
+            Some(MemoryTier::MediumTerm) => {
+                items.extend(
+                    self.working
+                        .items
+                        .iter()
+                        .filter(|item| task_matches(item))
+                        .cloned(),
+                );
+                items.extend(
+                    self.mtm
+                        .items
+                        .iter()
+                        .filter(|item| task_matches(item))
+                        .cloned(),
+                );
+            }
+            Some(MemoryTier::LongTerm) => {
+                items.extend(
+                    self.ltm
+                        .index
+                        .values()
+                        .filter(|meta| {
+                            meta.access_scope == owner_scope || meta.access_scope == "system"
+                        })
+                        .filter_map(|meta| self.load_ltm_item(&meta.id)),
+                );
+            }
+            None => {
+                items.extend(
+                    self.stm
+                        .items
+                        .iter()
+                        .filter(|item| task_matches(item))
+                        .cloned(),
+                );
+                items.extend(
+                    self.working
+                        .items
+                        .iter()
+                        .filter(|item| task_matches(item))
+                        .cloned(),
+                );
+                items.extend(
+                    self.mtm
+                        .items
+                        .iter()
+                        .filter(|item| task_matches(item))
+                        .cloned(),
+                );
+            }
+        }
+        items.sort_by(|a, b| {
+            b.importance
+                .partial_cmp(&a.importance)
+                .unwrap_or(std::cmp::Ordering::Equal)
+        });
+        items.truncate(12);
+        items
+    }
+
+    fn build_hierarchical_summary(items: &[MemoryItem]) -> String {
+        if items.is_empty() {
+            return String::new();
+        }
+        items
+            .iter()
+            .map(|item| {
+                format!(
+                    "[{}|{:.2}] {}",
+                    Self::tier_label(item.tier),
+                    item.importance,
+                    item.summary
+                        .clone()
+                        .unwrap_or_else(|| Self::compress_content(&item.content, 120))
+                )
+            })
+            .collect::<Vec<_>>()
+            .join("\n")
+    }
+
+    fn compress_overweight_context(&mut self, owner_scope: &str) -> EngineResult<usize> {
+        let total_chars: usize = self
+            .stm
+            .items
+            .iter()
+            .chain(self.working.items.iter())
+            .filter(|item| item.access_scope == owner_scope || item.access_scope == "system")
+            .map(|item| item.content.len())
+            .sum();
+
+        if total_chars < 4_000 {
+            return Ok(0);
+        }
+
+        let report = self.summarize(owner_scope, self.working.active_task_id.clone(), None)?;
+        Ok(usize::from(report.summary_id.is_some()))
+    }
+
+    fn promote_memory_to_ltm(&mut self, memory_id: &str) -> EngineResult<()> {
+        if let Some(idx) = self.stm.items.iter().position(|item| item.id == memory_id) {
+            if let Some(item) = self.stm.items.remove(idx) {
+                self.stm_index.remove(memory_id);
+                self.rebuild_stm_index();
+                self.mtm.items.push(item);
+                self.rebuild_mtm_index();
+            }
+        }
+
+        if let Some(idx) = self.mtm.items.iter().position(|item| item.id == memory_id) {
+            let item = self.mtm.items.remove(idx);
+            self.mtm_index.remove(memory_id);
+            let metadata = MemoryMetadata {
+                id: item.id.clone(),
+                memory_type: item.memory_type,
+                importance: item.importance,
+                tags: item.tags.to_vec(),
+                created_at: item.created_at,
+                file_path: self.ltm.storage_path.join(format!("{}.mem", item.id)),
+                compressed: true,
+                encrypted: true,
+                linked_memories: item.linked_memories.clone(),
+                retrieval_hints: item.retrieval_hints.to_vec(),
+                access_scope: item.access_scope.clone(),
+                task_id: item.task_id.clone(),
+                summary: item.summary.clone(),
+                utility_score: item.utility_score,
+            };
+            self.ltm.index.insert(item.id.clone(), metadata.clone());
+            let json = serde_json::to_string(&item)
+                .map_err(|e| EngineError::Runtime(format!("Failed to serialize summary: {}", e)))?;
+            std::fs::write(&metadata.file_path, json.as_bytes())
+                .map_err(|e| EngineError::Runtime(format!("Failed to persist summary: {}", e)))?;
+            self.rebuild_mtm_index();
+        }
+        Ok(())
+    }
+
+    fn tier_label(tier: MemoryTier) -> &'static str {
+        match tier {
+            MemoryTier::ShortTerm => "stm",
+            MemoryTier::MediumTerm => "mtm",
+            MemoryTier::LongTerm => "ltm",
+        }
+    }
+}
