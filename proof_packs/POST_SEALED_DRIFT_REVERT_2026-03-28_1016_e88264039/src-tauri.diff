+        }
+
+        if request.include_mtm {
+            for item in self.mtm.items.iter().cloned() {
+                self.maybe_push_ranked_result(
+                    &mut candidates,
+                    item,
+                    &request,
+                    &query_embedding,
+                    now,
+                );
+            }
+        }
+
+        if request.include_ltm {
+            for metadata in self.ltm.index.values() {
+                if metadata.access_scope != request.owner_scope && metadata.access_scope != "system"
+                {
+                    continue;
+                }
+                if metadata.importance < request.min_importance {
+                    continue;
+                }
+                if let Some(item) = self.load_ltm_item(&metadata.id) {
+                    self.maybe_push_ranked_result(
+                        &mut candidates,
+                        item,
+                        &request,
+                        &query_embedding,
+                        now,
+                    );
+                }
+            }
+        }
+
+        let mut results: Vec<MemoryQueryResult> = candidates.into_values().collect();
+        results.sort_by(|a, b| {
+            b.relevance_score
+                .partial_cmp(&a.relevance_score)
+                .unwrap_or(std::cmp::Ordering::Equal)
+        });
+        results.truncate(request.max_results.max(1));
+        results
+    }
+
+    pub fn prune(
+        &mut self,
+        owner_scope: &str,
+        max_age_ms: Option<u64>,
+        importance_threshold: f32,
+    ) -> EngineResult<MemoryPruneReport> {
+        let now = Self::current_timestamp();
+        let age_limit = max_age_ms.unwrap_or(self.mtm.retention_ms);
+
+        let removed_stm = Self::prune_deque_tier(
+            &mut self.stm.items,
+            owner_scope,
+            now,
+            age_limit,
+            importance_threshold,
+        );
+        if removed_stm > 0 {
+            self.rebuild_stm_index();
+        }
+
+        let removed_working = Self::prune_deque_tier(
+            &mut self.working.items,
+            owner_scope,
+            now,
+            age_limit / 4,
+            importance_threshold.min(0.8),
+        );
+        if removed_working > 0 {
+            self.rebuild_working_index();
+        }
+
+        let before_mtm = self.mtm.items.len();
+        self.mtm.items.retain(|item| {
+            let age_ms = now.saturating_sub(item.created_at);
+            !(item.access_scope == owner_scope
+                && age_ms > age_limit
+                && item.importance < importance_threshold)
+        });
+        let removed_mtm = before_mtm.saturating_sub(self.mtm.items.len());
+        if removed_mtm > 0 {
+            self.rebuild_mtm_index();
+        }
+
+        let ltm_ids_to_remove: Vec<String> = self
+            .ltm
+            .index
+            .iter()
+            .filter_map(|(id, meta)| {
+                let age_ms = now.saturating_sub(meta.created_at);
+                if meta.access_scope == owner_scope
+                    && age_ms > age_limit
+                    && meta.importance < importance_threshold
+                {
+                    Some(id.clone())
+                } else {
+                    None
+                }
+            })
+            .collect();
+
+        let removed_ltm = ltm_ids_to_remove.len();
+        for id in ltm_ids_to_remove {
+            if let Some(meta) = self.ltm.index.remove(&id) {
+                let _ = std::fs::remove_file(meta.file_path);
+            }
+        }
+
+        let compressed_units = self.compress_overweight_context(owner_scope)?;
+        self.update_stats();
+
+        Ok(MemoryPruneReport {
+            removed_stm,
+            removed_working,
+            removed_mtm,
+            removed_ltm,
+            compressed_units,
+        })
+    }
+
+    pub fn summarize(
+        &mut self,
+        owner_scope: &str,
+        task_id: Option<String>,
+        tier: Option<MemoryTier>,
+    ) -> EngineResult<MemorySummaryReport> {
+        let source_items = self.collect_summary_candidates(owner_scope, task_id.clone(), tier);
+        let source_count = source_items.len();
+        let summary = Self::build_hierarchical_summary(&source_items);
+        let utility_score = if source_items.is_empty() {
+            0.0
+        } else {
+            source_items
+                .iter()
+                .map(|item| item.utility_score)
+                .sum::<f32>()
+                / source_items.len() as f32
+        };
+        let reduction_ratio = if source_items.is_empty() {
+            0.0
+        } else {
+            let original_chars: usize = source_items.iter().map(|item| item.content.len()).sum();
+            1.0 - (summary.len() as f32 / original_chars.max(1) as f32)
+        };
+
+        let mut summary_id = None;
+        let mut promoted_to_ltm = false;
+        if !summary.is_empty() {
+            let importance = utility_score.clamp(0.4, 1.0);
+            let stored_id = self.store_enriched(StoreMemoryOptions {
+                content: summary.clone(),
+                memory_type: MemoryType::Knowledge,
+                importance,
+                tags: vec!["summary".to_string(), "consolidated".to_string()],
+                linked_memories: source_items.iter().map(|item| item.id.clone()).collect(),
+                retrieval_hints: vec!["summary".to_string(), owner_scope.to_string()],
+                access_scope: owner_scope.to_string(),
+                task_id,
+            })?;
+            summary_id = Some(stored_id.clone());
+
+            if utility_score >= 0.75 || importance >= 0.8 {
+                self.promote_memory_to_ltm(&stored_id)?;
+                promoted_to_ltm = true;
+            }
+        }
+
+        Ok(MemorySummaryReport {
+            summary_id,
+            source_tier: match tier {
+                Some(MemoryTier::ShortTerm) => "stm".to_string(),
+                Some(MemoryTier::MediumTerm) => "mtm".to_string(),
+                Some(MemoryTier::LongTerm) => "ltm".to_string(),
+                None => "mixed".to_string(),
+            },
+            source_count,
+            summary,
+            promoted_to_ltm,
+            utility_score,
+            context_reduction_ratio: reduction_ratio.clamp(0.0, 1.0),
+        })
+    }
