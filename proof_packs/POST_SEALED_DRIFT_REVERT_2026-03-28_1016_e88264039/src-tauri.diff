+fn average_disk_usage_percent() -> f64 {
+    let disks = sysinfo::Disks::new_with_refreshed_list();
+    let mut total_space = 0u128;
+    let mut used_space = 0u128;
+
+    for disk in disks.list() {
+        let disk_total = disk.total_space() as u128;
+        let disk_used = disk_total.saturating_sub(disk.available_space() as u128);
+        total_space = total_space.saturating_add(disk_total);
+        used_space = used_space.saturating_add(disk_used);
+    }
+
+    if total_space == 0 {
+        0.0
+    } else {
+        ((used_space as f64 / total_space as f64) * 100.0).clamp(0.0, 100.0)
+    }
+}
+
+fn network_connectivity_ok() -> bool {
+    ToSocketAddrs::to_socket_addrs("google.com:443").is_ok()
+}
+
+fn singularity_power_level(state: &CoreSingularityState) -> u32 {
+    let system_health = state.system_health.global_health.clamp(0.0, 1.0);
+    let coherence = match state.coherence.health() {
+        crate::core::types::EngineHealth::Healthy => 1.0,
+        crate::core::types::EngineHealth::Degraded => 0.7,
+        crate::core::types::EngineHealth::Failing => 0.35,
+        crate::core::types::EngineHealth::Offline => 0.1,
+    };
+    let harmony = match state.harmonia.health() {
+        crate::core::types::EngineHealth::Healthy => 1.0,
+        crate::core::types::EngineHealth::Degraded => 0.7,
+        crate::core::types::EngineHealth::Failing => 0.35,
+        crate::core::types::EngineHealth::Offline => 0.1,
+    };
+
+    ((system_health * 0.6 + coherence * 0.2 + harmony * 0.2) * 100.0).round() as u32
+}
+
+fn singularity_phase(state: &CoreSingularityState, reports_generated: u32, active: bool) -> String {
+    if !active {
+        return "Paused".to_string();
+    }
+
+    match state.health() {
+        crate::core::types::EngineHealth::Offline => "Offline".to_string(),
+        crate::core::types::EngineHealth::Failing => "Recovery".to_string(),
+        crate::core::types::EngineHealth::Degraded => "Stabilization".to_string(),
+        crate::core::types::EngineHealth::Healthy => {
+            if reports_generated > 0 {
+                "Adaptive Evolution".to_string()
+            } else if state.time_since_sync_seconds() <= 5 {
+                "Synchronized".to_string()
+            } else {
+                "Monitoring".to_string()
+            }
+        }
+    }
+}
+
+async fn collect_system_info(
+    singularity_state: &Arc<RwLock<CoreSingularityState>>,
+) -> Result<SystemInfo, String> {
+    use sysinfo::{Pid, System};
+
+    let mut sys = System::new_all();
+    sys.refresh_all();
+
+    let pid = Pid::from_u32(std::process::id());
+    let uptime = if let Some(process) = sys.process(pid) {
+        std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .ok()
+            .map(|d| d.as_secs() as i64 - process.start_time() as i64)
+            .unwrap_or(0) as u64
+    } else {
+        0
+    };
+
+    let cpu_usage = sys.global_cpu_usage() as f64;
+    let total_memory = sys.total_memory() as f64;
+    let memory_usage = if total_memory > 0.0 {
+        (sys.used_memory() as f64 / total_memory) * 100.0
+    } else {
+        0.0
+    };
+    let disk_usage = average_disk_usage_percent();
+
+    let state = singularity_state.read().await;
+    let singularity_active = !matches!(state.health(), crate::core::types::EngineHealth::Offline);
+
+    Ok(SystemInfo {
+        version: env!("CARGO_PKG_VERSION").to_string(),
+        uptime,
+        memory_usage,
+        cpu_usage,
+        disk_usage,
+        singularity_active,
+    })
+}
+
+async fn collect_singularity_status(
+    singularity_state: &Arc<RwLock<CoreSingularityState>>,
+    evolution: &AutoEvolutionEngine,
+) -> Result<SingularityStatus, String> {
+    let state = singularity_state.read().await;
+    let evolution_state = evolution.get_state().await.map_err(|e| e.to_string())?;
+
+    let active = evolution_state.active
+        && !matches!(state.health(), crate::core::types::EngineHealth::Offline);
+    let iterations = std::cmp::max(
+        evolution_state.reports_generated as u64,
+        state
+            .autonomy
+            .as_ref()
+            .map(|autonomy| autonomy.cycle_count)
+            .unwrap_or(0),
+    );
+
+    Ok(SingularityStatus {
+        active,
+        power_level: singularity_power_level(&state),
+        iterations,
+        phase: singularity_phase(&state, evolution_state.reports_generated, active),
+    })
+}
