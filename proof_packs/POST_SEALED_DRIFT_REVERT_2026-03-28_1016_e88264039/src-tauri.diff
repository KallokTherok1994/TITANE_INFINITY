+                signing_seed: signing_seed.to_vec(),
+            };
+            let bytes = serde_json::to_vec_pretty(&stored)
+                .map_err(|e| format!("Failed to serialize time-travel keys: {}", e))?;
+            tokio::fs::write(&path, bytes)
+                .await
+                .map_err(|e| format!("Failed to persist time-travel keys: {}", e))?;
+            stored
+        }
+        Err(err) => return Err(format!("Failed to read time-travel keys: {}", err)),
+    };
+
+    let master_key: [u8; 32] = stored
+        .master_key
+        .as_slice()
+        .try_into()
+        .map_err(|_| "Invalid persisted master key length for time-travel".to_string())?;
