+    fn build_retrieval_hints(content: &str, tags: &MemoryTags) -> Vec<String> {
+        let mut hints = tags.to_vec();
+        hints.extend(
+            content
+                .split_whitespace()
+                .take(6)
+                .map(|token| token.to_lowercase()),
+        );
+        hints.sort();
+        hints.dedup();
+        hints
+    }
