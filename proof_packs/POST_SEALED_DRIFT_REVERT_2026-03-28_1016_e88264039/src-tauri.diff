+
+    let stored = match tokio::fs::read(&path).await {
+        Ok(bytes) => serde_json::from_slice::<StoredTimeTravelKeys>(&bytes)
+            .map_err(|e| format!("Failed to parse time-travel keys: {}", e))?,
