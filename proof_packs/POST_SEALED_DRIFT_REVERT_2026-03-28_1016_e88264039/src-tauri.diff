+        stored.signing_seed.as_slice().try_into().map_err(|_| {
+            "Invalid persisted signing seed length for time-travel".to_string()
+        })?;
+
+    Ok((master_key, SigningKeypair::from_secret_bytes(signing_seed)))
+}
