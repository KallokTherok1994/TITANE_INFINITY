+    fn build_adaptive_instruction_block(&self, adaptive_summary: &AdaptiveSummary) -> String {
+        format!(
+            "\n\n## ADAPTIVE_EXECUTION\nmode={}\npredicted_load={:.2}\nconfidence={:.2}\nstress={:.2}\nreasoning_depth={:.2}\ndegraded_mode={}\ninstruction={}",
+            adaptive_summary.execution_policy.preferred_model_tier,
+            adaptive_summary.predicted_load,
+            adaptive_summary.confidence_index.overall,
+            adaptive_summary.saturation_state.stress_level,
+            adaptive_summary.execution_policy.reasoning_depth,
+            adaptive_summary.saturation_state.degraded_mode,
+            if adaptive_summary.saturation_state.degraded_mode {
+                "Respond with a concise and reliable answer, minimize speculative branches, and avoid unnecessary tool breadth."
+            } else if adaptive_summary.confidence_index.overall < 0.5 {
+                "Prefer verified, cautious output, mention uncertainty when needed, and use a tighter reasoning path."
+            } else {
+                "Maintain balanced depth, preserve coherence with memory context, and optimize for useful coverage."
+            }
+        )
+    }
+
+    async fn record_adaptive_observation(
+        &self,
+        adaptive_summary: &AdaptiveSummary,
+        request: &ConversationRequest,
+        omega_result: &OmegaPipelineResult,
+        provider_used: &str,
+        latency_ms: u64,
+        singularity_success: bool,
+        tag_count: usize,
+    ) {
+        let response_variance = (1.0
+            - request
+                .omega_meta
+                .as_ref()
+                .map(|meta| meta.confidence)
+                .unwrap_or(omega_result.confidence))
+        .clamp(0.0, 1.0);
+        let memory_context_present = request
+            .history
+            .as_ref()
+            .map(|history| !history.is_empty())
+            .unwrap_or(false);
+        let sample = SystemPerformanceSample {
+            timestamp: chrono::Utc::now().timestamp_millis() as u64,
+            cpu_load: adaptive_summary.avg_cpu_load.clamp(0.0, 1.0),
+            memory_usage: adaptive_summary.predicted_load.clamp(0.0, 1.0),
+            latency_ai: latency_ms as u128,
+            latency_tauri_invoke: (omega_result.latency_ms as u128 / 4).max(1),
+            ui_fps: 60,
+            sync_quality: if singularity_success { 0.92 } else { 0.65 },
+            cognitive_stability: ((omega_result.confidence + omega_result.safety_score) / 2.0)
+                .clamp(0.0, 1.0),
+            hash_integrity_ok: true,
+            response_variance,
+            sources_consulted: omega_result.sources.len().max(1) as u32,
+            memory_coherence: if memory_context_present { 0.85 } else { 0.55 },
+            pending_tasks: if adaptive_summary.saturation_state.degraded_mode {
+                adaptive_summary
+                    .execution_policy
+                    .recommended_max_parallel_agents
+                    .saturating_sub(1) as u32
+            } else {
+                0
+            },
+            token_cost: omega_result.tokens,
+            user_feedback: 0.0,
+            reasoning_depth: adaptive_summary.execution_policy.reasoning_depth,
+        };
+
+        let mut engine = self.adaptive_engine.lock().await;
+        engine.capture_sample(sample);
+        if tag_count > 0 || provider_used.to_ascii_lowercase().contains("offline") {
+            engine.learn();
+        }
+    }
 }
 
