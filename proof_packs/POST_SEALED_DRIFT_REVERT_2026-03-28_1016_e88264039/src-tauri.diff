+fn load_entries_from_disk(
+    file_path: &Path,
+    encryptor: Option<&MemoryEncryption>,
+) -> Result<Vec<PersistentMemoryEntry>, String> {
+    let raw_content = fs::read_to_string(file_path)
+        .map_err(|e| format!("Failed to read {}: {}", file_path.display(), e))?;
+
+    let json_content = if let Some(encryptor) = encryptor {
+        let decrypted = encryptor
+            .decrypt(&raw_content)
+            .map_err(|e| format!("Failed to decrypt {}: {}", file_path.display(), e))?;
+        String::from_utf8(decrypted)
+            .map_err(|e| format!("Failed to decode decrypted {}: {}", file_path.display(), e))?
+    } else {
+        raw_content
+    };
+
+    serde_json::from_str(&json_content)
+        .map_err(|e| format!("Failed to parse {}: {}", file_path.display(), e))
+}
