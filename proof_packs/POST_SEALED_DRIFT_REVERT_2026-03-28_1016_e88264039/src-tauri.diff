+        let contradiction_ratio = self.calculate_contradiction_ratio(&ctx);
+        let workload_harmony_score = self.calculate_workload_harmony_score(&ctx);
+        let emotional_coherence = self.calculate_emotional_coherence(&ctx);
+
+        let metrics = CoherenceMetrics {
