+            contradiction_ratio,
+            workload_harmony_score,
+            emotional_coherence,
+        };
+
+        // Calcul pondéré
+        let coherence_level = decision_alignment * WEIGHT_DECISION_ALIGNMENT
+            + contradiction_ratio * WEIGHT_CONTRADICTION_RATIO
