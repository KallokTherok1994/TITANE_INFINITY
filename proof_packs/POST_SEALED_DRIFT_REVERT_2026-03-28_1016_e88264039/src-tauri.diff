+    /// Régulation douce avec prédiction de charge et tendance amortie.
+    pub fn regulate(
+        &mut self,
+        observed_load: f32,
+        cognitive_stability: f32,
+        pending_tasks: usize,
+        average_latency_ms: u64,
+    ) {
+        let latency_pressure = clamp(average_latency_ms as f32 / 4000.0, 0.0, 1.0);
+        let queue_pressure = clamp(pending_tasks as f32 / 10.0, 0.0, 1.0);
+        let predicted_target = clamp(
+            observed_load * 0.55 + latency_pressure * 0.25 + queue_pressure * 0.20,
+            0.0,
+            1.0,
+        );
+
+        self.predicted_load = smooth_transition(self.predicted_load, predicted_target, 0.18);
+
+        let target_stability = clamp(
+            cognitive_stability * 0.7 + (1.0 - self.predicted_load) * 0.3,
+            0.0,
+            1.0,
+        );
+        self.stability = smooth_transition(self.stability, target_stability, 0.12);
+
+        let target_adaptability = clamp(
+            0.45 + (1.0 - self.predicted_load) * 0.25 + queue_pressure * 0.20,
+            0.0,
+            1.0,
+        );
+        self.adaptability = smooth_transition(self.adaptability, target_adaptability, 0.10);
+
+        let target_trend = clamp(
+            (target_stability - self.stability) * 1.5 + (cognitive_stability - 0.5) * 0.4,
+            -1.0,
+            1.0,
+        );
+        self.trend = smooth_transition(self.trend, target_trend, 0.15);
+    }
+}
+
+pub fn smooth_transition(current: f32, target: f32, factor: f32) -> f32 {
+    current + (target - current) * clamp(factor, 0.0, 1.0)
 }
 
