+        let avg_recent = (recent[0] + recent[1] + recent[2]) / 3.0;
+        let older: Vec<&f32> = history.iter().rev().skip(3).take(3).collect();
+
+        if older.len() < 3 {
+            return CoherenceTrend::Stable;
+        }
+
+        let avg_older = (older[0] + older[1] + older[2]) / 3.0;
+
+        if avg_recent > avg_older + 0.05 {
+            CoherenceTrend::Improving
+        } else if avg_recent < avg_older - 0.05 {
+            CoherenceTrend::Declining
+        } else {
+            CoherenceTrend::Stable
+        }
+    }
