+/// Store a memory entry (Unified Memory Engine)
+#[tauri::command]
+pub async fn unified_memory_store(
+    engine: State<'_, Arc<ConversationEngineState>>,
+    content: String,
+    role: Option<String>,
+    importance: Option<f32>,
+    tags: Option<Vec<String>>,
+) -> CommandResult<serde_json::Value> {
+    let mut mem = engine.unified_memory.write().await;
+    let entry_role = role.unwrap_or_else(|| "user".to_string());
+    let entry_importance = importance.unwrap_or(0.5);
+
+    let id = mem
+        .store(content, entry_role, entry_importance)
+        .await
+        .map_err(|e| e.to_string())?;
+
+    Ok(serde_json::json!({
+        "ok": true,
+        "id": id,
+        "message": "Memory stored successfully"
+    }))
+}
+
+/// Search memories (Unified Memory Engine)
+#[tauri::command]
+pub async fn unified_memory_search(
+    engine: State<'_, Arc<ConversationEngineState>>,
+    query: String,
+    max_results: Option<usize>,
+    min_importance: Option<f32>,
+    tier: Option<String>,
+) -> CommandResult<serde_json::Value> {
+    let mut mem = engine.unified_memory.write().await;
+    let limit = max_results.unwrap_or(10);
+
+    let bundle = mem.recall(&query, limit).await.map_err(|e| e.to_string())?;
+
+    let results: Vec<serde_json::Value> = bundle
+        .stm
+        .iter()
+        .chain(bundle.mtm.iter())
+        .chain(bundle.ltm.iter())
+        .take(limit)
+        .map(|entry| {
+            serde_json::json!({
+                "id": entry.id,
+                "content": entry.content,
+                "role": entry.role,
+                "importance": entry.importance,
+                "timestamp": entry.timestamp,
+                "tags": entry.tags,
+            })
+        })
+        .collect();
+
+    Ok(serde_json::json!({
+        "ok": true,
+        "results": results,
+        "total": results.len(),
+    }))
+}
+
+/// Compress memories using a strategy (Unified Memory Engine)
+#[tauri::command]
+pub async fn unified_memory_compress(
+    engine: State<'_, Arc<ConversationEngineState>>,
+    strategy: Option<String>,
+) -> CommandResult<serde_json::Value> {
+    let mut mem = engine.unified_memory.write().await;
+
+    let summary = mem.summarize().await.map_err(|e| e.to_string())?;
+
+    Ok(serde_json::json!({
+        "ok": true,
+        "summary": summary,
+        "strategy": strategy.unwrap_or_else(|| "key_messages".to_string()),
+    }))
+}
+
+/// Get memory statistics (Unified Memory Engine)
+#[tauri::command]
+pub async fn unified_memory_stats(
+    engine: State<'_, Arc<ConversationEngineState>>,
+) -> CommandResult<serde_json::Value> {
+    let mem = engine.unified_memory.read().await;
+    let stats = mem.stats();
+
+    serde_json::to_value(&stats).map_err(|e| e.to_string())
+}
+
+/// Write to scratchpad (Unified Memory Engine)
+#[tauri::command]
+pub async fn unified_memory_scratch_write(
+    engine: State<'_, Arc<ConversationEngineState>>,
+    session_id: String,
+    key: String,
+    value: String,
+    ttl_seconds: Option<u64>,
+) -> CommandResult<serde_json::Value> {
+    let scratchpad = engine.scratchpad.read().await;
+    scratchpad
+        .write(&session_id, &key, &value, ttl_seconds)
+        .map_err(|e| e.to_string())?;
+
+    Ok(serde_json::json!({
+        "ok": true,
+        "message": "Scratchpad entry written"
+    }))
+}
+
+/// Read from scratchpad (Unified Memory Engine)
+#[tauri::command]
+pub async fn unified_memory_scratch_read(
+    engine: State<'_, Arc<ConversationEngineState>>,
+    session_id: String,
+    key: String,
+) -> CommandResult<serde_json::Value> {
+    let scratchpad = engine.scratchpad.read().await;
+    let value = scratchpad
+        .read(&session_id, &key)
+        .map_err(|e| e.to_string())?;
+
+    Ok(serde_json::json!({
+        "ok": true,
+        "value": value,
+    }))
+}
+
+/// Configure retention policy (Unified Memory Engine)
+#[tauri::command]
+pub async fn unified_memory_retention_policy(
+    engine: State<'_, Arc<ConversationEngineState>>,
+    tier: Option<String>,
+    max_age_days: Option<u32>,
+    min_importance: Option<f32>,
+) -> CommandResult<serde_json::Value> {
+    let min_imp = min_importance.unwrap_or(0.01);
+
+    let mem = engine.unified_memory.read().await;
+    // Run retention cycle via public API
+    let updated = mem.update_retention().map_err(|e| e.to_string())?;
+    let purged = mem.purge_expired(min_imp).map_err(|e| e.to_string())?;
+
+    Ok(serde_json::json!({
+        "ok": true,
+        "updated": updated,
+        "purged": purged,
+        "config": {
+            "tier": tier.unwrap_or_else(|| "medium".to_string()),
+            "max_age_days": max_age_days.unwrap_or(90),
+            "min_importance": min_imp,
+        }
+    }))
+}
