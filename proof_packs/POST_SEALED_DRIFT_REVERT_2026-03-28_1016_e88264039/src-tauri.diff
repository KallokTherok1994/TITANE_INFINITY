+/// Hierarchical summarization: group by day, summarize each day, then merge
+///
+/// Strategy:
+/// 1. Group entries by day (using timestamp)
+/// 2. Summarize each day's entries
+/// 3. Combine daily summaries into final summary
+fn summarize_hierarchical(entries: &[MemoryEntry]) -> (String, usize) {
+    use std::collections::BTreeMap;
+
+    // Group by day (YYYY-MM-DD)
+    let mut daily_groups: BTreeMap<String, Vec<&MemoryEntry>> = BTreeMap::new();
+
+    for entry in entries {
+        let date = chrono::DateTime::from_timestamp_millis(entry.timestamp)
+            .map(|dt| dt.format("%Y-%m-%d").to_string())
+            .unwrap_or_else(|| "unknown".to_string());
+
+        daily_groups.entry(date).or_default().push(entry);
+    }
+
+    let mut summaries: Vec<String> = Vec::new();
+    let mut total_included: usize = 0;
+
+    for (date, day_entries) in daily_groups {
+        let important: Vec<&MemoryEntry> = day_entries
+            .iter()
+            .filter(|e| e.importance > 0.5)
+            .copied()
+            .collect();
+
+        let count = day_entries.len();
+        let topics: Vec<String> = important
+            .iter()
+            .take(3)
+            .map(|e| truncate_text(&e.content, 60))
+            .collect();
+
+        let day_summary = if topics.is_empty() {
+            format!("[{}] {} échanges", date, count)
+        } else {
+            format!("[{}] {} échanges — {}", date, count, topics.join("; "))
+        };
+
+        total_included += day_summary.len();
+        summaries.push(day_summary);
+    }
+
+    (summaries.join("\n"), total_included)
+}
+
+/// Extractive summarization: preserve entities and key facts
+///
+/// Strategy:
+/// 1. Extract entries with tags or high importance
+/// 2. Preserve named entities (capitalized words, patterns)
+/// 3. Keep factual statements (containing numbers, dates, names)
+fn summarize_extractive(entries: &[MemoryEntry]) -> (String, usize) {
+    let mut facts: Vec<String> = Vec::new();
+    let mut total_included: usize = 0;
+
+    for entry in entries {
+        // Include if high importance or has tags
+        if entry.importance > 0.6 || !entry.tags.is_empty() {
+            let extracted = extract_key_facts(&entry.content);
+            if !extracted.is_empty() {
+                let line = format!("• [{}] {}", entry.role, extracted);
+                total_included += line.len();
+                facts.push(line);
+            }
+        }
+    }
+
+    // Also include entries with numbers (likely factual)
+    for entry in entries {
+        if entry.content.chars().any(|c| c.is_ascii_digit()) && entry.importance > 0.4 {
+            let line = format!("• [{}] {}", entry.role, truncate_text(&entry.content, 120));
+            if !facts.iter().any(|f| f.contains(&entry.id)) {
+                total_included += line.len();
+                facts.push(line);
+            }
+        }
+    }
+
+    if facts.is_empty() {
+        // Fallback: first and last entry
+        if let Some(first) = entries.first() {
+            facts.push(format!("• Début: {}", truncate_text(&first.content, 100)));
+        }
+        if let Some(last) = entries.last() {
+            if entries.len() > 1 {
+                facts.push(format!("• Fin: {}", truncate_text(&last.content, 100)));
+            }
+        }
+        total_included = facts.iter().map(|f| f.len()).sum();
+    }
+
+    (facts.join("\n"), total_included)
+}
+
+/// Abstractive summarization: generate new coherent summary text
+///
+/// Strategy:
+/// 1. Identify main topics from high-importance entries
+/// 2. Build narrative structure (intro, body, conclusion)
+/// 3. Generate condensed summary preserving meaning
+fn summarize_abstractive(entries: &[MemoryEntry]) -> (String, usize) {
+    if entries.is_empty() {
+        return (String::new(), 0);
+    }
+
+    let total = entries.len();
+    let user_count = entries.iter().filter(|e| e.role == "user").count();
+    let assistant_count = entries.iter().filter(|e| e.role == "assistant").count();
+
+    // Identify main topics (from tags)
+    let mut tag_freq: std::collections::HashMap<String, usize> = std::collections::HashMap::new();
+    for entry in entries {
+        for tag in &entry.tags {
+            *tag_freq.entry(tag.clone()).or_insert(0) += 1;
+        }
+    }
+
+    let mut top_tags: Vec<(String, usize)> = tag_freq.into_iter().collect();
+    top_tags.sort_by(|a, b| b.1.cmp(&a.1));
+    let topics: Vec<String> = top_tags.iter().take(3).map(|(t, _)| t.clone()).collect();
+
+    // Get high-importance messages for key points
+    let mut important: Vec<&MemoryEntry> = entries.iter().filter(|e| e.importance > 0.7).collect();
+    important.sort_by(|a, b| {
+        b.importance
+            .partial_cmp(&a.importance)
+            .unwrap_or(std::cmp::Ordering::Equal)
+    });
+
+    let key_points: Vec<String> = important
+        .iter()
+        .take(5)
+        .map(|e| truncate_text(&e.content, 80))
+        .collect();
+
+    // Build summary
+    let intro = format!(
+        "Conversation de {} échanges ({} messages utilisateur, {} réponses assistant).",
+        total, user_count, assistant_count
+    );
+
+    let topics_str = if topics.is_empty() {
+        String::new()
+    } else {
+        format!("\nSujets principaux: {}.", topics.join(", "))
+    };
+
+    let key_points_str = if key_points.is_empty() {
+        String::new()
+    } else {
+        format!(
+            "\nPoints clés:\n{}",
+            key_points
+                .iter()
+                .map(|p| format!("• {}", p))
+                .collect::<Vec<_>>()
+                .join("\n")
+        )
+    };
+
+    let summary = format!("{}{}{}", intro, topics_str, key_points_str);
+    let included_len = summary.len();
+
+    (summary, included_len)
+}
+
+/// Extract key facts from text content
+fn extract_key_facts(text: &str) -> String {
+    // Extract sentences containing numbers, dates, or capitalized entities
+    let sentences: Vec<&str> = text.split(['.', '!', '?']).collect();
+
+    let factual: Vec<&str> = sentences
+        .iter()
+        .filter(|s| {
+            let has_number = s.chars().any(|c| c.is_ascii_digit());
+            let has_entity = s.split_whitespace().any(|w| {
+                w.len() > 2 && w.chars().next().map(|c| c.is_uppercase()).unwrap_or(false)
+            });
+            has_number || has_entity
+        })
+        .copied()
+        .collect();
+
+    if factual.is_empty() {
+        truncate_text(text, 100)
+    } else {
+        factual.join(". ").trim().to_string()
+    }
+}
