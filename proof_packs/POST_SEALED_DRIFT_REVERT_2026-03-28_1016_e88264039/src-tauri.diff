+            saturation_state: SaturationState::default(),
+            execution_policy: ExecutionPolicy::default(),
+            policy_weights: PolicyWeights::default(),
+            last_reward: 0.0,
+        }
+    }
+}
+
+fn clamp(value: f32, min: f32, max: f32) -> f32 {
+    value.max(min).min(max)
+}
+
+fn smooth_transition(current: f32, target: f32, factor: f32) -> f32 {
+    current + (target - current) * clamp(factor, 0.0, 1.0)
+}
+
+fn moving_average(values: &[f32]) -> f32 {
+    if values.is_empty() {
+        return 0.0;
+    }
+    values.iter().sum::<f32>() / values.len() as f32
+}
+
+fn kalman_update(error_estimate: &mut f32, estimate: f32, measurement: f32) -> f32 {
+    let process_noise = 0.05;
+    let measurement_noise = 0.15;
+    let predicted_error = *error_estimate + process_noise;
+    let kalman_gain = predicted_error / (predicted_error + measurement_noise);
+    let updated_estimate = estimate + kalman_gain * (measurement - estimate);
+    *error_estimate = (1.0 - kalman_gain) * predicted_error;
+    updated_estimate
+}
+
+fn action_priority(action: &AdaptiveAction) -> u8 {
+    match action {
+        AdaptiveAction::TriggerHumanReview => 0,
+        AdaptiveAction::EscalateModel => 1,
+        AdaptiveAction::EnterDegradedMode => 2,
+        AdaptiveAction::ReduceReasoningDepth => 3,
+        AdaptiveAction::LimitTokenBudget => 4,
+        AdaptiveAction::ReduceResearchBreadth => 5,
+        AdaptiveAction::OptimizeToolSequence => 6,
+        AdaptiveAction::RestoreNominalMode => 7,
+        _ => 8,
+    }
 }
 
