# TITANE∞ - Configuration automatique de l'environnement (direnv compatible)
# Usage: source .envrc OU utiliser direnv (https://direnv.net/)

# Ajouter Node.js local et pnpm au PATH
export PATH="$PWD/.tools/node/current/bin:${PNPM_HOME:-$HOME/.local/share/pnpm}:$PATH"

# Variables d'environnement du projet
export TITANE_ENV=development
export RUST_LOG=info
export RUST_BACKTRACE=1

# Désactiver les messages npm fund/audit lors du développement
export npm_config_fund=false
export npm_config_audit=false
