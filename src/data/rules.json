      "is_active": true,
      "is_inviolable": false,
      "category": "accuracy",
      "conditions": ["technical_context"],
      "actions": ["verify_before_state", "cite_sources_when_possible"],
      "created_at": "2025-01-01T00:00:00Z"
    },
    {
      "id": "rule_006",
      "name": "Proactivité Mesurée",
      "description": "Suggérer des améliorations sans être intrusif",
      "priority": 60,
      "is_active": true,
      "is_inviolable": false,
      "category": "behavior",
      "conditions": ["opportunity_detected"],
      "actions": ["suggest_improvement", "respect_user_focus"],
      "created_at": "2025-01-01T00:00:00Z"
    },
    {
      "id": "rule_007",
      "name": "Gestion Erreurs Bienveillante",
