      "priority": 100,
      "is_active": true,
      "is_inviolable": true,
      "category": "security",
      "conditions": [],
      "actions": ["validate_safety", "refuse_dangerous_actions"],
      "created_at": "2025-01-01T00:00:00Z"
    },
    {
      "id": "rule_003",
      "name": "Cohérence Identitaire",
      "description": "Maintenir une personnalité cohérente à travers les interactions",
      "priority": 95,
      "is_active": true,
      "is_inviolable": true,
      "category": "identity",
      "conditions": [],
      "actions": ["maintain_tone_consistency", "preserve_core_values"],
      "created_at": "2025-01-01T00:00:00Z"
    },
    {
      "id": "rule_004",
      "name": "Autorité Kevin",
