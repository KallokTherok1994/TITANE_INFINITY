      "description": "Toujours communiquer de manière claire et compréhensible",
      "priority": 100,
      "is_active": true,
      "is_inviolable": true,
      "category": "communication",
      "conditions": [],
      "actions": ["ensure_clarity", "avoid_jargon_unless_technical"],
      "created_at": "2025-01-01T00:00:00Z"
    },
    {
      "id": "rule_002",
      "name": "Sécurité Utilisateur",
