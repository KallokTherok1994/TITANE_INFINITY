# ═══════════════════════════════════════════════════════════════
#   TITANE∞ v28.0.0 — Environment Configuration Template
# ═══════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────
# REQUIRED VARIABLES
# ──────────────────────────────────────────────────────────────

# Data Root Directory (Required)
# Path to TITANE∞ data storage directory
TITANE_DATA_ROOT=/path/to/titane/data

# ──────────────────────────────────────────────────────────────
# AI PROVIDERS (At least one recommended)
# ──────────────────────────────────────────────────────────────

# Enable External AI Providers (REQUIRED for Gemini/OpenAI/Anthropic)
# By default, TITANE∞ runs in LOCAL-ONLY mode (privacy/security)
# Set to "1" to enable external cloud providers
# Frontend enforces this gate in conversationEngine.ts (v27.1+)
# Backend double-checks for defense-in-depth (v27.2.1+)
# Options: 1 (enabled), 0 or unset (disabled)
# VITE_ENABLE_EXTERNAL_AI=1

# Google Gemini API
# Get your key: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API (Optional)
# Get your key: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude API (Optional)
# Get your key: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ──────────────────────────────────────────────────────────────
# LOCAL AI (Ollama)
# ──────────────────────────────────────────────────────────────

# Ollama Base URL
# Default: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# Ollama Default Model
# Canonical desktop profile: gemma2:2b
OLLAMA_DEFAULT_MODEL=gemma2:2b

# ──────────────────────────────────────────────────────────────
# LOGGING & DEBUGGING
# ──────────────────────────────────────────────────────────────

# Rust Log Level
# Options: error, warn, info, debug, trace
RUST_LOG=info

# Tauri Debug Mode
# Options: true, false
TAURI_DEBUG=false

# ──────────────────────────────────────────────────────────────
# PERFORMANCE TUNING
# ──────────────────────────────────────────────────────────────

# Cache Size (MB)
TITANE_CACHE_SIZE_MB=512

# Max Concurrent Tasks
TITANE_MAX_CONCURRENT_TASKS=10

# Memory Cleanup Interval (seconds)
TITANE_MEMORY_CLEANUP_INTERVAL=300

# ──────────────────────────────────────────────────────────────
# SECURITY (P0 — REQUIRED IN PRODUCTION)
# ──────────────────────────────────────────────────────────────

# ⚠️  P0 REQUIRED: Secrets Engine Passphrase (AES-256-GCM)
# If NOT set, TITANE∞ will log a warning and fall back to an
# INSECURE hardcoded dev passphrase. All stored API keys will
# NOT be safely protected. Generate a strong random value:
#   openssl rand -hex 32
TITANE_SECRETS_PASSPHRASE=your_strong_passphrase_here

# Enable Rate Limiting
TITANE_RATE_LIMITING_ENABLED=true

# Rate Limit Requests per Minute
TITANE_RATE_LIMIT_RPM=60

# Enable Encryption
TITANE_ENCRYPTION_ENABLED=true

# ──────────────────────────────────────────────────────────────
# OPTIONAL: ADVANCED CONFIGURATION
# ──────────────────────────────────────────────────────────────

# ElevenLabs TTS API (Optional)
# For text-to-speech functionality
# ELEVENLABS_API_KEY=your_elevenlabs_key_here

# Database Path (Optional)
# Default: $TITANE_DATA_ROOT/titane.db
# TITANE_DB_PATH=/custom/path/to/database.db

# Port for development server (Optional)
# Default: 1420
# TITANE_DEV_PORT=1420

# ──────────────────────────────────────────────────────────────
# CONVERSATION ENGINE — OMEGA FLAGS
# ──────────────────────────────────────────────────────────────

# Web search in OMEGA pipeline (default: true)
# CONVOS_SEARCH=true

# Store sources in conversation memory (default: true)
# CONVOS_SOURCES_STORE=true

# Conversation memory snapshots (default: true)
# CONVOS_MEMORY_SNAPSHOTS=true

# Debug panel data in conversation responses (default: true)
# CONVOS_DEBUG_PANEL=true

# ⚠️  LTM (Long-Term Memory) — DISABLED BY DEFAULT
# Long-Term Memory promotes STM→MTM→LTM for persistent recall.
# Set to "true" to activate multi-tier memory in production.
# Requires neural_memory Consolidator to be operational.
# CONVOS_MEMORY_LTM=false

# Comma-separated feature allowlist (default: all allowed)
# TITANE_CONVOS_ALLOWLIST=

# ──────────────────────────────────────────────────────────────
# FEATURE FLAGS
# ──────────────────────────────────────────────────────────────

# Enable ONNX Runtime (Requires system libraries)
# TITANE_ONNX_ENABLED=false

# Enable Audio Capture (Requires libasound2-dev on Linux)
# TITANE_AUDIO_CAPTURE_ENABLED=false

# Enable Developer Mode
# TITANE_DEVELOPER_MODE=false

# ──────────────────────────────────────────────────────────────
# NOTES
# ──────────────────────────────────────────────────────────────
# 
# 1. Copy this file to .env and fill in your values
# 2. Never commit .env to version control
# 3. Restart TITANE∞ after changing environment variables
# 4. See docs/ for detailed configuration guide
#
# System Dependencies:
# - Linux: sudo apt install libasound2-dev (for audio-capture)
# - ONNX Runtime: Download from https://github.com/microsoft/onnxruntime
#
# ═══════════════════════════════════════════════════════════════
