# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║ TITANE∞ v12.0 - Configuration Environnement (TEMPLATE)                      ║
# ║ Copier ce fichier en .env et remplir avec vos vraies valeurs                ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# ─────────────────────────────────────────────────────────────────────────────
# API GEMINI (Google Generative AI)
# ─────────────────────────────────────────────────────────────────────────────
# Obtenir une clé API : https://makersuite.google.com/app/apikey
# ❗️ Ne pas laisser la clé en clair en production. Utiliser la commande `chat_set_gemini_key`
# pour l'injecter dans SecureSecretsEngine. Cette variable .env n'est utilisée que pour un
# bootstrap initial (migration automatique vers le coffre chiffré).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-pro
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1

# ─────────────────────────────────────────────────────────────────────────────
# OLLAMA (IA Locale)
# ─────────────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:latest

# ─────────────────────────────────────────────────────────────────────────────
# CONFIGURATION SYSTÈME TITANE
# ─────────────────────────────────────────────────────────────────────────────
# Passphrase pour mémoire chiffrée (AES-256-GCM)
TITANE_MEMORY_PASSPHRASE=change_me_in_production

# Passphrase obligatoire pour SecureSecretsEngine (Argon2id + AES-256-GCM)
# Longueur minimale recommandée: 16 caractères (alphnum + symboles)
TITANE_SECRETS_PASSPHRASE=

# Chemins de stockage
TITANE_DATA_PATH=./data
TITANE_MEMORY_PATH=./data/memory
TITANE_LOGS_PATH=./logs

# ─────────────────────────────────────────────────────────────────────────────
# SENTRY (Error Monitoring & Performance Tracking)
# ─────────────────────────────────────────────────────────────────────────────
# Obtenir un DSN : https://sentry.io/ (créer un projet React)
# Format : https://[KEY]@[ORG_ID].ingest.sentry.io/[PROJECT_ID]
# Laisser vide pour désactiver Sentry
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_APP_VERSION=19.5.2

# ─────────────────────────────────────────────────────────────────────────────
# MODE DEBUG
# ─────────────────────────────────────────────────────────────────────────────
# Rust backend logging level
RUST_LOG=info
RUST_BACKTRACE=1

# Frontend logging level (Phase 4 - Week 6)
# Options: TRACE, DEBUG, INFO, WARN, ERROR, FATAL, SILENT
# TRACE: Very verbose (all logs including performance traces)
# DEBUG: Development debugging (default for dev mode)
# INFO: General information (default for production)
# WARN: Warnings only
# ERROR: Errors only
# FATAL: Critical errors only
# SILENT: No logs
VITE_LOG_LEVEL=DEBUG
