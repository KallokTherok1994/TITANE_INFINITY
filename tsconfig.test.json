{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "typeRoots": ["./node_modules/@types", "./node_modules"],
    "types": ["vitest/globals", "@testing-library/jest-dom", "node"],
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/test/**/*",
    "src/__tests__/**/*",
    "src/tests/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
