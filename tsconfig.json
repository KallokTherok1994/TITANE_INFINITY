{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "typeRoots": ["./node_modules/@types"],
    "types": [],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Path aliases */
    "paths": {
      "@/*": ["./src/*"],
      "@app/*": ["./src/app/*"],
      "@pages/*": ["./src/pages/*"],
      "@features/*": ["./src/features/*"],
      "@components/*": ["./src/components/*"],
      "@ui/*": ["./src/ui/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@services/*": ["./src/services/*"],
      "@stores/*": ["./src/stores/*"],
      "@themes/*": ["./src/themes/*"],
      "@utils/*": ["./src/utils/*"],
      "@types/*": ["./src/types/*"],
      "@assets/*": ["./src/assets/*"],
      "@styles/*": ["./src/styles/*"],
      "@data/*": ["./data/*"],
      "@config/*": ["./config/*"],
      "@a11y/*": ["./src/a11y/*"],
      "@apps/*": ["./src/apps/*"],
      "@cognitive/*": ["./src/cognitive/*"]
    },

    /* Linting - Enhanced Strict (Progressive) */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    // TEMPORAIREMENT DÉSACTIVÉS - Migration progressive requise (1217 erreurs)
    // "exactOptionalPropertyTypes": true, // P1-2: Disabled 2026-01-03 (migration needed)
    // "noPropertyAccessFromIndexSignature": true, // P1-2: Disabled 2026-01-03 (migration needed)
    "noUnusedLocals": false, // P1-2: Disabled 2026-01-03 (non-blocking warnings)
    "noUnusedParameters": false, // P1-2: Disabled 2026-01-03 (non-blocking warnings)
    "noFallthroughCasesInSwitch": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true
  },
  "include": ["src", "src/types"],
  "exclude": [
    ".venv",
    "**/.venv/**",
    "src/__tests__",
    "**/__tests__/**",
    "src/test/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "src/hooks/archived/**",
    "src/_deprecated/**",
    "src/examples/**",
    "src/stories/**",
    "src/lib/anomalyDetector.ts",
    "src/lib/metricsCache.ts",
    "src/lib/predictiveAlerts.ts",
    "src/lib/serviceMetrics.ts",
    "src/components/physiological/**",
    "src/ui/pages/ControlPanel/sections/**"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
