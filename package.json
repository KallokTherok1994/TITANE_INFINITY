{
  "name": "titane-infinity",
  "version": "24.1.0",
  "description": "TITANE∞ v24.1.0 - UI Architecture Evolution: 2 Unified Centers (Orchestration & Intelligence + Identity & Memory Evolution) - Living Systems Philosophy",
  "type": "module",
  "license": "SEE LICENSE.md",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "dev:tauri": "tauri dev",
    "build": "npm run type-check && vite build",
    "build:watch": "vite build --watch",
    "preview": "vite preview",
    "tauri": "tauri",
    "start": "echo '🔒 TAURI-ONLY MODE: Use npm run dev instead' && exit 1",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "vite:dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "tauri:build:debug": "tauri build --debug",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf node_modules dist .vite src-tauri/target",
    "clean:dist": "rm -rf dist",
    "clean:cache": "rm -rf .vite node_modules/.vite",
    "reinstall": "npm run clean && npm install",
    "verify": "sh ./verify_global_system.sh",
    "verify:cognitive": "sh ./verify_cognitive_synthesis.sh && sh ./verify_strategic_direction.sh && sh ./verify_advanced_cognitive.sh",
    "verify:stacks": "sh ./verify_cognitive_stack.sh && sh ./verify_neural_mesh.sh && sh ./verify_perception_stack.sh",
    "verify:tauri": "sh ./verify_tauri_v2_api.sh",
    "verify:backend": "sh ./scripts/verify_backend.sh",
    "verify:backend:quick": "sh ./scripts/verify_backend.sh --quick",
    "verify:backend:deep": "sh ./scripts/verify_backend.sh --deep",
    "repair:backend": "sh ./scripts/repair_backend.sh",
    "test:build": "npm run type-check && npm run build",
    "test": "node ./scripts/run-vitest.mjs",
    "test:watch": "vitest --config vitest.unit.config.ts --watch",
    "test:watch:integration": "vitest --config vitest.integration.config.ts --watch",
    "test:ui": "vitest --config vitest.unit.config.ts --ui",
    "test:coverage": "vitest run --config vitest.unit.config.ts --coverage",
    "test:unit": "cross-env NODE_OPTIONS=--max-old-space-size=8192 vitest run --config vitest.unit.config.ts",
    "test:integration": "cross-env NODE_OPTIONS=--max-old-space-size=8192 vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:rust": "cd src-tauri && cargo test",
    "test:all": "bash tests/run_all_tests.sh",
    "test:ci": "npm run lint && npm run type-check && npm run test && npm run test:e2e && npm run test:rust",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "docs": "typedoc",
    "docs:serve": "npx http-server ./docs/api -p 8080"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-http": "^2.5.4",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "@types/three": "^0.181.0",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^11.7.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.25",
    "lucide-react": "^0.554.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.6",
    "react-window": "^2.2.3",
    "recharts": "^3.4.1",
    "remark-gfm": "^4.0.1",
    "three": "^0.181.2",
    "uuid": "^11.0.5",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.3",
    "@playwright/test": "^1.56.1",
    "@storybook/addon-a11y": "^10.0.8",
    "@storybook/addon-docs": "^10.0.8",
    "@storybook/addon-onboarding": "^10.0.8",
    "@storybook/addon-vitest": "^10.0.8",
    "@storybook/react-vite": "^10.0.8",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.25",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@types/react-router-dom": "^5.3.3",
    "@types/react-window": "^1.8.8",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/ui": "^4.0.13",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "eslint-plugin-storybook": "^10.0.8",
    "happy-dom": "^20.0.10",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.2.0",
    "jsdom": "^27.2.0",
    "playwright": "^1.56.1",
    "prettier": "^3.6.2",
    "rollup-plugin-visualizer": "^6.0.5",
    "storybook": "^10.0.8",
    "terser": "^5.44.1",
    "ts-jest": "^29.4.5",
    "typedoc": "^0.28.14",
    "typedoc-plugin-markdown": "^4.9.0",
    "typescript": "^5.5.3",
    "vite": "^6.4.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.13"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
