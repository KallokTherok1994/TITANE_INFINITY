    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^11.7.0",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.0.0",
    "dompurify": "^3.0.6",
    "eventemitter3": "^5.0.1",
    "framer-motion": "^12.25.0",
    "i18next": "^25.7.4",
    "i18next-browser-languagedetector": "^7.2.0",
    "lucide-react": "^0.562.0",
    "react-chartjs-2": "^5.3.1",
    "react-chrono": "^3.3.3",
    "react-d3-tree": "^3.6.2",
    "react-i18next": "^13.5.0",
    "react-is": "^19.2.3",
    "react-markdown": "^10.1.0",
    "react-router": "^7.12.0",
    "react-router-dom": "^7.12.0",
    "recharts": "^3.5.1",
    "remark-gfm": "^4.0.1",
    "three": "^0.182.0",
    "web-vitals": "^5.1.0",
    "zod": "^4.3.5",
    "zustand": "^5.0.9"
  },
