{
  "name": "titane-infinity",
  "version": "19.5.2",
  "description": "TITANE∞ v19.5.2 - Production Ready: Phase A+B Complete, Build 25MB, Tests 98.2%, Boot ~2s, IPC Profiler, Memory Baseline, 5 Linux Packages",
  "type": "module",
  "license": "SEE LICENSE.md",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "dev:tauri": "tauri dev",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "preview": "vite preview",
    "tauri": "tauri",
    "start": "echo '🔒 TAURI-ONLY MODE: Use npm run dev instead' && exit 1",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "vite:dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "tauri:build:debug": "tauri build --debug",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:staged": "lint-staged",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "check": "tsc --noEmit",
    "audit": "npm audit && cargo audit",
    "clean": "rm -rf node_modules target dist",
    "prebuild": "npm run check && npm run lint",
    "build:prod": "npm run prebuild && npm run tauri build",
    "test:build": "npm run type-check && npm run build",
    "test": "node ./scripts/run-vitest.mjs",
    "test:watch": "jest --watch",
    "test:ui": "vitest --config vitest.unit.config.ts --ui",
    "test:coverage": "jest --coverage",
    "test:unit": "cross-env NODE_OPTIONS=--max-old-space-size=8192 vitest run --config vitest.unit.config.ts",
    "test:integration": "cross-env NODE_OPTIONS=--max-old-space-size=8192 vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:rust": "cd src-tauri && cargo test",
    "test:all": "npm run test && npm run test:e2e && cargo test",
    "test:ci": "npm run lint && npm run type-check && npm run test && npm run test:e2e && npm run test:rust",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "docs": "typedoc",
    "docs:serve": "npx http-server ./docs/api -p 8080",
    "prepare": "husky install",
    "test:a11y": "jest --testPathPattern=a11y",
    "lint:a11y": "eslint --plugin jsx-a11y"
  },
  "dependencies": {
    "@sentry/react": "^10.29.0",
    "@tauri-apps/api": "^2.9.1",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.4.4",
    "@tauri-apps/plugin-http": "^2.5.4",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "@types/dompurify": "^3.0.5",
    "@types/three": "^0.181.0",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^11.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.0.0",
    "dompurify": "^3.0.6",
    "eventemitter3": "^5.0.1",
    "framer-motion": "^12.23.25",
    "i18next": "^23.7.0",
    "i18next-browser-languagedetector": "^7.2.0",
    "react-i18next": "^13.5.0",
    "react-router": "^7.10.1",
    "react-router-dom": "^7.10.1",
    "web-vitals": "^5.1.0",
    "zod": "^4.1.13",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@axe-core/react": "^4.8.0",
    "@chromatic-com/storybook": "^4.1.3",
    "@playwright/test": "^1.56.1",
    "@storybook/addon-a11y": "^10.0.8",
    "@storybook/addon-docs": "^10.0.8",
    "@storybook/addon-onboarding": "^10.0.8",
    "@storybook/addon-vitest": "^10.0.8",
    "@storybook/react-vite": "^10.0.8",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/clipboardy": "^1.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.25",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@types/react-router-dom": "^5.3.3",
    "@types/react-window": "^1.8.8",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^4.0.15",
    "@vitest/ui": "^4.0.13",
    "axe-core": "^4.11.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "eslint-plugin-storybook": "^10.0.8",
    "happy-dom": "^20.0.10",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.2.0",
    "jsdom": "^27.2.0",
    "lint-staged": "^16.2.7",
    "playwright": "^1.56.1",
    "prettier": "^3.6.2",
    "rollup-plugin-visualizer": "^6.0.5",
    "typescript": "^5.5.3",
    "uuid": "^13.0.0",
    "vite": "^6.4.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.13"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix --max-warnings 10",
      "prettier --write"
    ],
    "*.{json,md,css,scss}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
