{
  "version": "v31.8.0",
  "category": "chat_config_map",
  "description": "Cartographie complète de la configuration et des instructions du chat TITANE∞ — sources canoniques, pipeline 10 étapes, modes IA, providers, timeouts, mémoire hybride et classification automatique de mode.",
  "chat_pipeline": {
    "flow": "useChat → chatEngine → canonicalDiscernmentKernel → chatEngineCommands (IPC) → OMEGA Pipeline Rust → AIRouter → providers → reflectiveVerifier (Self-RAG) → qualityVerifier → memoryIntegration.save → cognitiveOmega.save",
    "source_principal": "src/hooks/useChat.ts",
    "source_engine": "src/services/ai/chatEngine.ts",
    "etapes_pipeline": [
      "1. Cache check (responseCache — skip pour: creative, journal, brainstorming, reflection, hybrid)",
      "2. inputValidator.validate()",
      "3. memoryIntegration.loadContext() — timeout 5 000 ms",
      "4. canonicalDiscernmentKernel.discern() — décision unique de routing",
      "5. buildTitanePrompt() — core/prompts.ts + injection identité kernel",
      "6. getEffectiveProfile() — responsePolicy.ts (DIRECT/BALANCED/DEEP/ARCHITECT)",
      "7. chatEngineCommands → secureInvoke → IPC Tauri → OMEGA Pipeline Rust",
      "8. reflectiveVerifier — Self-RAG correction post-génération",
      "9. qualityVerifier — score heuristique 0-1",
      "10. memoryIntegration.saveInteraction() + cognitiveOmega.saveInteraction()"
    ],
    "global_timeout_ms": 52000,
    "streaming_timeout_ms": 58000,
    "cache_disabled_modes": ["creative", "journal", "brainstorming", "reflection", "hybrid"]
  },
  "identity_sources": {
