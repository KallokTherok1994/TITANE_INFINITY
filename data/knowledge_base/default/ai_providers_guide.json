{
  "version": "v30.0.0",
  "category": "ai_providers_guide",
  "description": "Guide complet des providers IA TITANE∞: routing, fallback, configuration, modèles recommandés",
  "ai_routing": {
    "description": "AIRouter Multi-Provider v30.0.0. Routage intelligent avec fallback automatique.",
    "path": "src-tauri/src/ai/",
    "decision_logic": [
      "1. Vérifier disponibilité provider prioritaire (online first)",
      "2. Si indisponible → passer au prochain dans la chaîne",
      "3. Si tous online indisponibles → Ollama local",
      "4. Si Ollama indisponible → erreur explicite (jamais silence)"
    ],
    "quality_evaluation": "Chaque réponse est scorée (pertinence, cohérence, complétude). Le score guide le routage futur.",
    "cache": "LRU cache pour les requêtes identiques récentes (TTL: 5min)"
  },
  "providers": {
    "openai": {
      "name": "OpenAI",
      "status": "online_primary",
      "models": {
        "gpt4": {"id": "gpt-4-turbo-preview", "context_window": 128000, "use_for": "Raisonnement complexe, code, analyse"},
        "gpt4o": {"id": "gpt-4o", "context_window": 128000, "use_for": "Vision, multimodal, conversations longues"},
        "gpt35": {"id": "gpt-3.5-turbo", "context_window": 16385, "use_for": "Tâches simples, faible coût"}
      },
      "env_key": "OPENAI_API_KEY",
      "endpoint": "https://api.openai.com/v1/chat/completions",
      "features": ["streaming", "function_calling", "vision", "embeddings"],
      "rate_limit": "60 RPM (tier 1), 3500 RPM (tier 3)"
    },
    "claude": {
      "name": "Anthropic Claude",
      "status": "online_secondary",
      "models": {
        "claude3_opus": {"id": "claude-3-opus-20240229", "context_window": 200000, "use_for": "Analyses profondes, écriture créative"},
        "claude3_sonnet": {"id": "claude-3-5-sonnet-20241022", "context_window": 200000, "use_for": "Balance qualité/vitesse"},
        "claude3_haiku": {"id": "claude-3-haiku-20240307", "context_window": 200000, "use_for": "Réponses rapides, faible coût"}
      },
      "env_key": "ANTHROPIC_API_KEY",
      "endpoint": "https://api.anthropic.com/v1/messages",
      "features": ["streaming", "tool_use", "vision", "long_context"],
      "strength": "Raisonnement nuancé, sécurité renforcée, contexte très long"
    },
    "gemini": {
      "name": "Google Gemini",
      "status": "online_tertiary",
      "models": {
        "gemini15_pro": {"id": "gemini-1.5-pro", "context_window": 1000000, "use_for": "Contexte très long, multimodal"},
        "gemini15_flash": {"id": "gemini-1.5-flash", "context_window": 1000000, "use_for": "Vitesse maximale"},
        "gemini20_flash": {"id": "gemini-2.0-flash", "context_window": 1000000, "use_for": "Dernière génération rapide"}
      },
      "env_key": "GEMINI_API_KEY",
      "ipc_set_key": "chat_set_gemini_key",
      "features": ["streaming", "multimodal", "grounding", "code_execution", "very_long_context"],
      "strength": "Contexte de 1M tokens, multimodal natif, intégration Google Search"
    },
    "ollama": {
      "name": "Ollama (Local)",
      "status": "local_primary_fallback",
      "host": "127.0.0.1",
      "port": 11434,
      "default_model": "gemma2:2b",
      "env_model": "OLLAMA_DEFAULT_MODEL",
      "env_base_url": "OLLAMA_BASE_URL",
      "auto_start": "Automatique au démarrage (desktop). Cherche: bundled binary → system ollama.",
      "recommended_models": [
        {"id": "gemma2:2b", "size": "1.6GB", "use_for": "Usage général léger (défaut)"},
        {"id": "gemma2:9b", "size": "5.5GB", "use_for": "Usage général avancé"},
        {"id": "llama3.1:8b", "size": "4.7GB", "use_for": "Raisonnement, code"},
        {"id": "mistral:7b", "size": "4.1GB", "use_for": "Conversation, instruction"},
        {"id": "codellama:7b", "size": "3.8GB", "use_for": "Code uniquement"},
        {"id": "nomic-embed-text", "size": "274MB", "use_for": "Embeddings sémantiques"},
        {"id": "deepseek-r1:7b", "size": "4.7GB", "use_for": "Raisonnement chain-of-thought"},
        {"id": "phi3:mini", "size": "2.2GB", "use_for": "Ultra léger, mobile/faible RAM"}
      ],
      "ipc_commands": ["test_ollama", "ping_ollama", "ollama_generate", "ollama_query", "ai_scan_local_models", "ai_set_local_model"],
      "android_note": "Sur Android: pas d'Ollama local — utiliser OLLAMA_BASE_URL pointant vers serveur LAN"
    }
  },
  "fallback_chain": [
    {"order": 1, "provider": "openai", "condition": "OPENAI_API_KEY disponible ET serveur accessible"},
    {"order": 2, "provider": "claude", "condition": "ANTHROPIC_API_KEY disponible ET serveur accessible"},
    {"order": 3, "provider": "gemini", "condition": "GEMINI_API_KEY disponible ET serveur accessible"},
    {"order": 4, "provider": "ollama", "condition": "Ollama process en cours sur port 11434"},
    {"order": 5, "provider": "error", "condition": "Tous indisponibles → erreur explicite avec IPC { ok: false, error: '...' }"}
  ],
  "streaming": {
    "description": "Toutes les réponses peuvent être streamées via événements Tauri",
    "event_format": "titane://ai-stream-chunk — payload: { token: string, done: bool }",
    "ipc_command": "ai_query_streaming",
    "benefit": "Affichage progressif — l'utilisateur voit les tokens arriver en temps réel"
  },
  "omega_pipeline_integration": {
    "description": "L'OMEGA Pipeline (10 étapes) orchestre les appels IA avec contexte enrichi",
    "stages": [
      "1. Validation (sécurité, filtres)",
      "2. Routing (choix provider optimal)",
      "3. Context enrichissement (mémoire LTM/MTM)",
      "4. Execution (appel provider)",
      "5. Memory update (sauvegarder dans STM/MTM)",
      "6. Quality check (évaluer la réponse)",
      "7. Merge (fusionner si multi-provider)",
      "8. Filter (guardrails, modération)",
      "9. Format (adapter au format demandé)",
      "10. Output (retourner via IPC)"
    ]
  }
}
