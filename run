#!/bin/bash
# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  🚀 TITANE∞ - Simple Launcher Wrapper                                    ║
# ║  Usage: run titane [dev|prod|quick|rebuild]                              ║
# ╚══════════════════════════════════════════════════════════════════════════╝

PROJECT_ROOT="/home/titane-os/Documents/GitHub/TITANE_INFINITY"

# Vérifier que le script existe
if [ ! -f "$PROJECT_ROOT/run-titane.sh" ]; then
    echo "❌ ERROR: run-titane.sh not found in $PROJECT_ROOT"
    exit 1
fi

# Parse arguments et convertir en flags
FLAGS=""
MODE_SET=false

for arg in "$@"; do
    case $arg in
        dev|development)
            FLAGS="$FLAGS --dev"
            MODE_SET=true
            ;;
        prod|production|stable)
            FLAGS="$FLAGS --prod"
            MODE_SET=true
            ;;
        quick|fast)
            FLAGS="$FLAGS --quick"
            ;;
        rebuild|clean)
            FLAGS="$FLAGS --rebuild"
            ;;
        no-check|nocheck)
            FLAGS="$FLAGS --no-check"
            ;;
        help|--help|-h)
            echo "🚀 TITANE∞ Launcher"
            echo ""
            echo "Usage: run titane [options]"
            echo ""
            echo "Modes:"
            echo "  dev, development      Launch in development mode (default)"
            echo "  prod, production      Launch in production mode"
            echo ""
            echo "Options:"
            echo "  quick, fast           Skip cleanup & checks (fast launch)"
            echo "  rebuild, clean        Force full rebuild"
            echo "  no-check, nocheck     Skip type checking & linting"
            echo ""
            echo "Examples:"
            echo "  run titane            # Dev mode with full checks"
            echo "  run titane quick      # Dev mode, quick launch"
            echo "  run titane prod       # Production mode"
            echo "  run titane rebuild    # Force full rebuild"
            exit 0
            ;;
        *)
            echo "⚠️  Unknown option: $arg (use 'run titane help')"
            ;;
    esac
done

# Si aucun mode spécifié, utiliser dev par défaut
if [ "$MODE_SET" = false ]; then
    FLAGS="--dev $FLAGS"
fi

# Lancer le script principal
cd "$PROJECT_ROOT"
exec ./run-titane.sh $FLAGS
