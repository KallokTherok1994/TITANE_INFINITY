# TITANE∞ Android example env (local only, do not commit secrets or LAN addresses)
# Use these exports in the shell that runs `tauri android ...`.

# Canonical Ollama endpoint for Android.
# Must point to a reachable LAN host running Ollama; the phone does not host Ollama.
export OLLAMA_BASE_URL=http://__LAN_HOST__:11434

# Canonical model selection.
export OLLAMA_DEFAULT_MODEL=gemma2:2b
export TITANE_OLLAMA_MODEL=gemma2:2b

# Optional request timeout for slower LAN / model combinations.
export OLLAMA_REQUEST_TIMEOUT_SECS=120
