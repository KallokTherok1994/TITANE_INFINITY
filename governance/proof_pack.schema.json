{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "governance/proof_pack.schema.json",
  "title": "TITANE Proof Pack",
  "type": "object",
  "required": ["path", "requiredFiles", "gates", "finalVerdict"],
  "properties": {
    "path": { "type": "string", "minLength": 1 },
    "requiredFiles": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["PASS", "FAIL", "BLOCKED", "BLOCKED_APPROVAL"]
          }
        },
        "additionalProperties": true
      }
    },
    "finalVerdict": {
      "type": "string",
      "enum": ["EXPERIMENTAL", "QUALIFIED", "STABLE", "SEALED", "FAIL", "BLOCKED"]
    }
  },
  "additionalProperties": true
}
